{
  "name": "gemini-live-chat",
  "version": "1.0.0",
  "description": "Minimal multimodal AI chat demo using the Gemini Live API",
  "type": "module",
  "private": true,
  "scripts": {
    "dev:server": "node server/index.js",
    "dev:client": "npm --prefix client run dev",
    "dev": "concurrently \"npm:dev:server\" \"npm:dev:client\"",
    "build": "npm --prefix client run build",
    "start": "node server/index.js"
  },
  "dependencies": {
    "@google/genai": "latest",
    "dotenv": "^16.4.5",
    "express": "^4.19.2"
  },
  "devDependencies": {
    "concurrently": "^9.0.1"
  }
}
