# Google Cloud Vertex AI Configuration
# When using GCP ADC, the SDK automatically reads credentials from:
# ~/.config/gcloud/application_default_credentials.json (set by `gcloud auth application-default login`)
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
GEMINI_MODEL=gemini-1.5-flash

# Backend server port
PORT=5001

# Frontend API URL (defaults to http://127.0.0.1:5001)
NEXT_PUBLIC_API_URL=http://127.0.0.1:5001
