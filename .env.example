# Copy to .env.local and fill in your key. .env.local is git-ignored.

# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Model slugs (verified present on OpenRouter's /api/v1/models list).
# Text reasoning model - used by the Advisory and Market agents.
OPENROUTER_TEXT_MODEL=anthropic/claude-sonnet-4.5
# Vision model - MUST accept image input. Used by the Disease Detection agent.
OPENROUTER_VISION_MODEL=google/gemini-2.5-flash

# Optional attribution headers sent to OpenRouter.
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_SITE_NAME=AgriPilot
