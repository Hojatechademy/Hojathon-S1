# Git Ignore for SahayAI
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Environments & Virtual Environments
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# Streamlit
.streamlit/secrets.toml

# Operating System Files
.DS_Store
Thumbs.db
desktop.ini

# Scratch / Temporary test files
scratch/test*.py
scratch/test*.pdf
temp/
*.tmp
