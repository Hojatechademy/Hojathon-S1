<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>ExpertForge - Universal Learning Platform</title>
  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Lucide Icons -->
  <script src="https://unpkg.com/lucide@latest"></script>
  <!-- PDF.js for PDF slides parsing -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js"></script>
  <!-- Mammoth.js for Word DOCX parsing -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/mammoth/1.6.0/mammoth.browser.min.js"></script>
  <!-- MediaPipe Hands & Camera Utils for Gesture Detection -->
  <script src="https://cdn.jsdelivr.net/npm/@mediapipe/camera_utils/camera_utils.js" crossorigin="anonymous"></script>
  <script src="https://cdn.jsdelivr.net/npm/@mediapipe/hands/hands.js" crossorigin="anonymous"></script>
  <!-- Direct Vector jsPDF Library (Never Blank) -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
  <style>
    .perspective { perspective: 1000px; }
    .transform-style-preserve { transform-style: preserve-3d; }
    .rotate-y-180 { transform: rotateY(180deg); }
    .backface-hidden { backface-visibility: hidden; }
  </style>
</head>
<body class="bg-slate-950 text-slate-100 min-h-screen font-sans antialiased selection:bg-indigo-500 selection:text-white flex flex-col relative">

  <!-- TOP NAV -->
  <header class="border-b border-slate-900 bg-slate-950/80 backdrop-blur sticky top-0 z-40">
    <div class="max-w-6xl mx-auto px-6 h-16 flex items-center justify-between">
      <div class="flex items-center space-x-3 cursor-pointer" onclick="goToView('home')">
        <div class="w-8 h-8 rounded-xl bg-gradient-to-tr from-indigo-500 to-violet-500 flex items-center justify-center shadow-lg shadow-indigo-500/20">
          <i data-lucide="flame" class="w-4 h-4 text-white"></i>
        </div>
        <span class="text-lg font-bold tracking-tight bg-gradient-to-r from-white to-slate-300 bg-clip-text text-transparent">ExpertForge</span>
        <span id="active-model-tag" class="text-[10px] uppercase font-bold tracking-wider bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 px-2 py-0.5 rounded-full ml-1">GPT-OSS-120B</span>
      </div>

      <div id="nav-actions" class="flex items-center gap-3"></div>
    </div>
  </header>

  <!-- MAIN CONTAINER -->
  <main class="max-w-5xl mx-auto px-6 py-10 flex-1 w-full pb-28">

    <!-- VIEW 1: CLEAN 2-CHOICE OPENING -->
    <section id="view-home" class="min-h-[75vh] flex flex-col justify-center items-center text-center space-y-10">
      <div class="space-y-3 max-w-xl">
        <span class="text-[11px] font-bold uppercase tracking-widest bg-indigo-500/10 text-indigo-400 border border-indigo-500/20 px-3 py-1 rounded-full">
          Autonomous Learning Platform
        </span>
        <h1 class="text-4xl sm:text-5xl font-extrabold tracking-tight text-white leading-tight">
          Any lecture source, forged into personalized mastery.
        </h1>
        <p class="text-slate-400 text-sm leading-relaxed">
          Upload audio recordings, PDF slides, Word documents, or whiteboard photos. Take a 4-question pre-test, and receive an adaptive masterclass with AI gesture assistance, visual mindmaps, and full PDF export.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 w-full max-w-2xl">
        <div onclick="startForgeFlow()" class="group bg-slate-900/60 hover:bg-slate-900 border border-slate-800/80 hover:border-indigo-500/50 p-8 rounded-3xl cursor-pointer transition-all duration-300 flex flex-col items-center text-center space-y-4 hover:shadow-2xl hover:shadow-indigo-500/10">
          <div class="w-14 h-14 rounded-2xl bg-indigo-600/10 border border-indigo-500/20 text-indigo-400 group-hover:scale-110 group-hover:bg-indigo-600 group-hover:text-white transition duration-300 flex items-center justify-center">
            <i data-lucide="sparkles" class="w-7 h-7"></i>
          </div>
          <div>
            <h3 class="text-lg font-bold text-white group-hover:text-indigo-400 transition">Forge a Course</h3>
            <p class="text-xs text-slate-400 mt-1">Ingest MP3, PDF slides, DOCX notes, or whiteboard images into an adaptive curriculum.</p>
          </div>
        </div>

        <div onclick="goToView('courses')" class="group bg-slate-900/60 hover:bg-slate-900 border border-slate-800/80 hover:border-emerald-500/50 p-8 rounded-3xl cursor-pointer transition-all duration-300 flex flex-col items-center text-center space-y-4 hover:shadow-2xl hover:shadow-emerald-500/10">
          <div class="w-14 h-14 rounded-2xl bg-emerald-600/10 border border-emerald-500/20 text-emerald-400 group-hover:scale-110 group-hover:bg-emerald-600 group-hover:text-white transition duration-300 flex items-center justify-center">
            <i data-lucide="book-marked" class="w-7 h-7"></i>
          </div>
          <div>
            <h3 class="text-lg font-bold text-white group-hover:text-emerald-400 transition">View Courses</h3>
            <p class="text-xs text-slate-400 mt-1">Access saved courses, review all flashcards, visual mindmaps, and take dynamic quizzes.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- VIEW 2: MULTIMODAL FORGE WIZARD -->
    <section id="view-forge" class="hidden max-w-2xl mx-auto space-y-8">
      <button onclick="goToView('home')" class="text-xs text-slate-400 hover:text-white flex items-center gap-1 transition">
        <i data-lucide="arrow-left" class="w-3.5 h-3.5"></i> Back to Home
      </button>

      <!-- Upload Step -->
      <div id="forge-step-upload" class="bg-slate-900 border border-slate-800/80 rounded-3xl p-8 space-y-6 shadow-xl">
        <div class="text-center space-y-1">
          <span class="text-[10px] font-bold text-indigo-400 uppercase tracking-wider">Step 1 of 3</span>
          <h2 class="text-2xl font-bold">Upload Lecture Material</h2>
          <p class="text-xs text-slate-400">Audio (MP3/WAV), Slide Decks (PDF), Documents (DOCX/TXT), or Whiteboards (PNG/JPG)</p>
        </div>

        <div>
          <label class="text-xs font-semibold text-slate-400 uppercase tracking-wider block mb-1.5">Lecture / Topic Name (Optional)</label>
          <input id="input-lecture-title" type="text" placeholder="e.g. LLM Parameters & Architecture by Dr. Thorne" class="w-full bg-slate-950 border border-slate-800 rounded-xl px-4 py-2.5 text-xs text-slate-200 focus:outline-none focus:border-indigo-500" />
        </div>

        <div class="border-2 border-dashed border-slate-800 hover:border-indigo-500/50 rounded-2xl p-8 text-center space-y-4 transition">
          <input type="file" id="universal-file-input" accept="audio/*,.pdf,.docx,.txt,image/*" class="hidden" onchange="handleUniversalUpload(event)" />
          
          <div class="flex justify-center items-center gap-3 text-slate-500">
            <div class="w-10 h-10 rounded-xl bg-slate-800/80 flex items-center justify-center text-indigo-400"><i data-lucide="headphones" class="w-5 h-5"></i></div>
            <div class="w-10 h-10 rounded-xl bg-slate-800/80 flex items-center justify-center text-rose-400"><i data-lucide="file-text" class="w-5 h-5"></i></div>
            <div class="w-10 h-10 rounded-xl bg-slate-800/80 flex items-center justify-center text-blue-400"><i data-lucide="file-type-2" class="w-5 h-5"></i></div>
            <div class="w-10 h-10 rounded-xl bg-slate-800/80 flex items-center justify-center text-amber-400"><i data-lucide="image" class="w-5 h-5"></i></div>
          </div>

          <div>
            <label for="universal-file-input" class="cursor-pointer text-sm font-semibold text-indigo-400 hover:underline">Click to browse any lecture file</label>
            <p class="text-[11px] text-slate-500 mt-1" id="upload-filename-display">Accepts MP3, PDF, DOCX, TXT, PNG, JPG</p>
          </div>
        </div>

        <div class="flex flex-wrap items-center justify-center gap-3 pt-2">
          <button onclick="loadDemoLecture('audio')" class="text-xs bg-slate-800 hover:bg-slate-700 text-slate-300 px-3.5 py-2 rounded-xl border border-slate-700/50 flex items-center gap-1.5 transition">
            <i data-lucide="headphones" class="w-3.5 h-3.5 text-indigo-400"></i> Sample Audio
          </button>
          <button onclick="loadDemoLecture('slides')" class="text-xs bg-slate-800 hover:bg-slate-700 text-slate-300 px-3.5 py-2 rounded-xl border border-slate-700/50 flex items-center gap-1.5 transition">
            <i data-lucide="presentation" class="w-3.5 h-3.5 text-rose-400"></i> Sample PDF Slides
          </button>
        </div>
      </div>

      <!-- Processing Step -->
      <div id="forge-step-processing" class="hidden bg-slate-900 border border-slate-800/80 rounded-3xl p-8 space-y-5 text-center shadow-xl">
        <div class="w-12 h-12 mx-auto rounded-full border-2 border-indigo-500 border-t-transparent animate-spin"></div>
        <div class="space-y-1">
          <h3 id="processing-title" class="text-lg font-bold">Extracting Knowledge Primitives...</h3>
          <p id="processing-subtitle" class="text-xs text-slate-400">Processing input content...</p>
        </div>
        <div id="processing-transcript-preview" class="hidden text-left bg-slate-950 p-4 rounded-xl border border-slate-800 font-mono text-[11px] text-slate-400 max-h-36 overflow-y-auto leading-relaxed"></div>
      </div>

      <!-- Diagnostic Step -->
      <div id="forge-step-pretest" class="hidden bg-slate-900 border border-slate-800/80 rounded-3xl p-8 space-y-6 shadow-xl">
        <div class="flex items-start justify-between">
          <div>
            <span class="text-[10px] font-bold text-indigo-400 uppercase tracking-wider">Step 2 of 3</span>
            <h3 class="text-xl font-bold mt-0.5">Pre-Course Diagnostic Test</h3>
            <p class="text-xs text-slate-400">Answer these 4 questions so the Agent can calibrate module depth, flashcards, mindmap, and quiz.</p>
          </div>
          <span class="text-xs font-mono bg-indigo-500/10 text-indigo-400 px-2.5 py-1 rounded-full border border-indigo-500/20">4 MCQs</span>
        </div>

        <div id="pretest-questions-list" class="space-y-4"></div>

        <button onclick="submitPreTest()" class="w-full py-3 bg-gradient-to-r from-indigo-600 to-violet-600 hover:from-indigo-500 hover:to-violet-500 rounded-xl text-xs font-bold text-white shadow-lg shadow-indigo-600/20 transition flex items-center justify-center gap-2">
          <span>Evaluate My Skill & Forge Course</span>
          <i data-lucide="arrow-right" class="w-4 h-4"></i>
        </button>
      </div>
    </section>

    <!-- VIEW 3: COURSE LIBRARY -->
    <section id="view-courses" class="hidden space-y-6">
      <div class="flex items-center justify-between">
        <div>
          <h2 class="text-2xl font-bold">Course Library</h2>
          <p class="text-xs text-slate-400">All forged courses are saved locally in your browser.</p>
        </div>
        <button onclick="startForgeFlow()" class="px-4 py-2 bg-indigo-600 hover:bg-indigo-500 rounded-xl text-xs font-semibold flex items-center gap-2 transition">
          <i data-lucide="plus" class="w-4 h-4"></i> Forge New
        </button>
      </div>

      <div id="courses-grid" class="grid grid-cols-1 md:grid-cols-2 gap-6"></div>
    </section>

    <!-- VIEW 4: FINE-TUNED COURSE STUDY VIEW (WITH MINDMAP & PDF EXPORT) -->
    <section id="view-course-study" class="hidden space-y-8">
      <!-- Course Top Nav -->
      <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 pb-4 border-b border-slate-900">
        <button onclick="goToView('courses')" class="text-xs text-slate-400 hover:text-white flex items-center gap-1.5 transition">
          <i data-lucide="arrow-left" class="w-3.5 h-3.5"></i> All Courses
        </button>
        <div class="flex items-center gap-3">
          <div class="flex items-center gap-2 text-xs">
            <span class="text-slate-500">Evaluated Level:</span>
            <span id="study-track-pill" class="font-bold px-3 py-1 rounded-full bg-indigo-500/10 text-indigo-400 border border-indigo-500/30 uppercase tracking-wider">
              Level 2: Architect
            </span>
          </div>

          <!-- Gesture Sense Status Pill -->
          <button onclick="toggleGestureDetection()" id="btn-gesture-toggle" class="text-xs bg-slate-900 hover:bg-slate-800 border border-slate-800 px-3 py-1 rounded-full flex items-center gap-1.5 transition text-slate-400">
            <i data-lucide="hand" class="w-3.5 h-3.5"></i> Gesture: <span id="gesture-status-text" class="text-slate-500">Off</span>
          </button>
        </div>
      </div>

      <!-- Course Header -->
      <div class="bg-gradient-to-r from-slate-900 via-indigo-950/30 to-slate-900 border border-slate-800/80 p-7 rounded-3xl space-y-2.5 shadow-xl">
        <h1 id="study-course-title" class="text-2xl sm:text-3xl font-extrabold text-white"></h1>
        <p id="study-course-expert" class="text-xs text-slate-400"></p>
      </div>

      <!-- Navigation Tabs (5 Sections) -->
      <div class="flex border-b border-slate-800 gap-6 text-sm font-semibold overflow-x-auto pb-px">
        <button onclick="setStudyTab('overview')" id="study-tab-btn-overview" class="pb-3 border-b-2 border-indigo-500 text-indigo-400 transition flex items-center gap-2 whitespace-nowrap">
          <i data-lucide="info" class="w-4 h-4"></i> 1. Overview
        </button>
        <button onclick="setStudyTab('modules')" id="study-tab-btn-modules" class="pb-3 border-b-2 border-transparent text-slate-400 hover:text-slate-200 transition flex items-center gap-2 whitespace-nowrap">
          <i data-lucide="layers" class="w-4 h-4"></i> 2. Modules <span id="badge-module-count" class="text-[10px] bg-slate-800 px-2 py-0.5 rounded-full text-slate-400"></span>
        </button>
        <button onclick="setStudyTab('flashcards')" id="study-tab-btn-flashcards" class="pb-3 border-b-2 border-transparent text-slate-400 hover:text-slate-200 transition flex items-center gap-2 whitespace-nowrap">
          <i data-lucide="copy" class="w-4 h-4"></i> 3. Flashcards <span id="badge-card-count" class="text-[10px] bg-slate-800 px-2 py-0.5 rounded-full text-slate-400"></span>
        </button>
        <button onclick="setStudyTab('quiz')" id="study-tab-btn-quiz" class="pb-3 border-b-2 border-transparent text-slate-400 hover:text-slate-200 transition flex items-center gap-2 whitespace-nowrap">
          <i data-lucide="check-circle-2" class="w-4 h-4"></i> 4. Quiz <span id="badge-quiz-count" class="text-[10px] bg-slate-800 px-2 py-0.5 rounded-full text-slate-400"></span>
        </button>
        <button onclick="setStudyTab('mindmap')" id="study-tab-btn-mindmap" class="pb-3 border-b-2 border-transparent text-slate-400 hover:text-slate-200 transition flex items-center gap-2 whitespace-nowrap text-indigo-300">
          <i data-lucide="network" class="w-4 h-4 text-indigo-400"></i> 5. Mindmap & Export
        </button>
      </div>

      <!-- TAB 1: OVERVIEW -->
      <div id="study-tab-overview" class="space-y-6">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          <div class="md:col-span-2 space-y-6">
            <div class="bg-slate-900 border border-slate-800/80 p-6 rounded-3xl space-y-3 shadow-lg">
              <h3 class="text-xs font-bold uppercase tracking-wider text-indigo-400 flex items-center gap-2">
                <i data-lucide="book-open" class="w-4 h-4"></i> What You Are Going to Learn
              </h3>
              <p id="overview-description" class="text-sm text-slate-300 leading-relaxed font-normal"></p>
            </div>

            <div class="bg-indigo-950/30 border border-indigo-800/40 p-6 rounded-3xl space-y-3 shadow-lg">
              <div class="flex items-center gap-2 text-indigo-300 font-semibold text-xs uppercase tracking-wider">
                <i data-lucide="brain-circuit" class="w-4 h-4 text-indigo-400"></i> Pathfinder Skill Diagnosis & Gap Radar
              </div>
              <p id="overview-diagnostic-note" class="text-xs text-slate-300 leading-relaxed"></p>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 pt-2">
                <div class="p-3 bg-slate-950/60 rounded-xl border border-slate-800">
                  <span class="text-[10px] font-bold uppercase text-emerald-400">Demonstrated Strength</span>
                  <p id="overview-strength" class="text-xs text-slate-300 mt-0.5"></p>
                </div>
                <div class="p-3 bg-slate-950/60 rounded-xl border border-slate-800">
                  <span class="text-[10px] font-bold uppercase text-amber-400">Calibrated Focus Area</span>
                  <p id="overview-focus" class="text-xs text-slate-300 mt-0.5"></p>
                </div>
              </div>
            </div>
          </div>

          <div class="bg-slate-900 border border-slate-800/80 p-6 rounded-3xl space-y-5 shadow-lg h-fit">
            <h3 class="text-xs font-bold uppercase tracking-wider text-slate-400">Course Metadata</h3>
            
            <div class="space-y-3.5 text-xs">
              <div class="flex items-center justify-between pb-3 border-b border-slate-800/80">
                <span class="text-slate-400 flex items-center gap-2"><i data-lucide="clock" class="w-4 h-4 text-indigo-400"></i> Est. Time</span>
                <span id="overview-time" class="font-bold text-slate-200">~25 mins</span>
              </div>
              <div class="flex items-center justify-between pb-3 border-b border-slate-800/80">
                <span class="text-slate-400 flex items-center gap-2"><i data-lucide="layers" class="w-4 h-4 text-indigo-400"></i> Total Modules</span>
                <span id="overview-modules-count" class="font-bold text-slate-200"></span>
              </div>
              <div class="flex items-center justify-between pb-3 border-b border-slate-800/80">
                <span class="text-slate-400 flex items-center gap-2"><i data-lucide="copy" class="w-4 h-4 text-indigo-400"></i> Flashcards</span>
                <span id="overview-cards-count" class="font-bold text-slate-200"></span>
              </div>
              <div class="flex items-center justify-between">
                <span class="text-slate-400 flex items-center gap-2"><i data-lucide="award" class="w-4 h-4 text-indigo-400"></i> Target Level</span>
                <span id="overview-level" class="font-bold text-indigo-400"></span>
              </div>
            </div>

            <button onclick="setStudyTab('modules')" class="w-full py-3 bg-indigo-600 hover:bg-indigo-500 rounded-2xl text-xs font-bold text-white transition flex items-center justify-center gap-2 shadow-lg shadow-indigo-600/30">
              <span>Start Module 1</span>
              <i data-lucide="arrow-right" class="w-3.5 h-3.5"></i>
            </button>
          </div>
        </div>
      </div>

      <!-- TAB 2: MODULES -->
      <div id="study-tab-modules" class="hidden space-y-6">
        <div id="modules-list" class="space-y-6"></div>
      </div>

      <!-- TAB 3: FLASHCARDS -->
      <div id="study-tab-flashcards" class="hidden space-y-6">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2">
          <div>
            <h3 class="text-lg font-bold">Interactive Flashcard Deck</h3>
            <p class="text-xs text-slate-400">Click any card to flip between the challenge prompt and explanation.</p>
          </div>
          <button onclick="flipAllCards()" class="self-start sm:self-auto text-xs bg-slate-900 hover:bg-slate-800 border border-slate-800 text-indigo-400 px-3.5 py-2 rounded-xl transition flex items-center gap-1.5">
            <i data-lucide="refresh-cw" class="w-3.5 h-3.5"></i> Flip All Cards
          </button>
        </div>

        <div id="flashcards-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5"></div>
      </div>

      <!-- TAB 4: QUIZ -->
      <div id="study-tab-quiz" class="hidden max-w-2xl mx-auto space-y-6">
        <div class="flex items-center justify-between">
          <div>
            <h3 class="text-lg font-bold">Mastery Assessment</h3>
            <p class="text-xs text-slate-400">Scenario questions scaled to lecture depth. Instant validation with expert rationales.</p>
          </div>
          <div id="quiz-score-badge" class="hidden text-xs font-bold px-3 py-1.5 rounded-full bg-emerald-500/10 text-emerald-400 border border-emerald-500/20"></div>
        </div>

        <div id="quiz-container" class="space-y-6"></div>
      </div>

      <!-- TAB 5: REVISION BLUEPRINT MINDMAP & PDF EXPORT -->
      <div id="study-tab-mindmap" class="hidden space-y-6">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 bg-slate-900 border border-slate-800/80 p-6 rounded-3xl shadow-lg">
          <div>
            <div class="flex items-center gap-2">
              <span class="text-[10px] font-bold uppercase tracking-wider bg-indigo-500/10 text-indigo-400 border border-indigo-500/20 px-2.5 py-0.5 rounded-full">Revision & Export</span>
              <h3 class="text-lg font-bold text-white">Course Mindmap & PDF Exporter</h3>
            </div>
            <p class="text-xs text-slate-400 mt-1">Review the conceptual architecture tree or download the complete course as a PDF with quiz and answer key.</p>
          </div>

          <!-- Export Actions Bar -->
          <div class="flex flex-wrap items-center gap-2.5">
            <button onclick="redrawMindmap()" class="text-xs bg-slate-800 hover:bg-slate-700 text-slate-300 px-3.5 py-2.5 rounded-xl transition flex items-center gap-1.5 border border-slate-700/50">
              <i data-lucide="rotate-ccw" class="w-3.5 h-3.5"></i> Redraw
            </button>
            <button onclick="downloadMindmapImage()" class="text-xs bg-slate-800 hover:bg-slate-700 text-slate-200 font-medium px-4 py-2.5 rounded-xl border border-slate-700/50 transition flex items-center gap-1.5">
              <i data-lucide="image" class="w-3.5 h-3.5 text-indigo-400"></i> Mindmap PNG
            </button>
            <button onclick="downloadCoursePDF()" id="btn-download-pdf" class="text-xs bg-gradient-to-r from-indigo-600 to-violet-600 hover:from-indigo-500 hover:to-violet-500 text-white font-semibold px-4 py-2.5 rounded-xl shadow-lg shadow-indigo-600/30 transition flex items-center gap-2">
              <i data-lucide="file-down" class="w-4 h-4"></i> Download Course PDF
            </button>
          </div>
        </div>

        <!-- High-Def Canvas Container -->
        <div class="bg-slate-900 border border-slate-800/80 rounded-3xl p-4 overflow-x-auto shadow-2xl flex justify-center">
          <canvas id="mindmap-canvas" class="rounded-2xl max-w-full bg-slate-950 border border-slate-800/60"></canvas>
        </div>
      </div>
    </section>

  </main>

  <!-- FLOATING WIDGET: "FORGER" AI ASSISTANT -->
  <div id="forger-floating-container" class="fixed bottom-6 right-6 z-50 flex flex-col items-end">
    
    <div id="forger-chat-window" class="hidden mb-3 w-80 sm:w-96 bg-slate-900/95 border border-slate-800 rounded-3xl shadow-2xl backdrop-blur-xl flex flex-col overflow-hidden transition-all duration-300">
      <div class="p-4 bg-slate-950/80 border-b border-slate-800 flex items-center justify-between">
        <div class="flex items-center gap-2.5">
