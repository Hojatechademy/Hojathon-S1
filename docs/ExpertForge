      link.click();
    }

    // VECTOR jsPDF EXPORT (NO INDIGO/PURPLE)
    async function downloadCoursePDF() {
      if (!currentCourse) return;
      const btn = document.getElementById('btn-download-pdf');
      const orig = btn.innerHTML;
      btn.disabled = true;
      btn.innerHTML = `<i data-lucide="loader-2" class="w-4 h-4 animate-spin"></i> Exporting...`;
      lucide.createIcons();

      try {
        const { jsPDF } = window.jspdf || window;
        const doc = new jsPDF({ orientation: 'portrait', unit: 'pt', format: 'a4' });
        const pageWidth = 595.28;
        const pageHeight = 841.89;
        const margin = 40;
        const contentWidth = pageWidth - (margin * 2);
        let y = margin;

        function checkAddPage(heightNeeded = 30) {
          if (y + heightNeeded > pageHeight - margin) {
            doc.addPage();
            y = margin;
          }
        }

        // Duolingo Green top bar
        doc.setFillColor(88, 204, 2);
        doc.rect(margin, y, contentWidth, 4, 'F');
        y += 18;

        doc.setFont('helvetica', 'bold');
        doc.setFontSize(16);
        doc.setTextColor(19, 31, 36);
        const titleLines = doc.splitTextToSize(currentCourse.title || "Masterclass", contentWidth);
        doc.text(titleLines, margin, y);
        y += (titleLines.length * 20);

        doc.setFont('helvetica', 'normal');
        doc.setFontSize(9);
        doc.setTextColor(100, 116, 139);
        doc.text(`Track: ${currentCourse.level || 'Architect'}  •  Date: ${new Date().toLocaleDateString()}`, margin, y);
        y += 18;

        doc.setFont('helvetica', 'bold');
        doc.setFontSize(12);
        doc.setTextColor(19, 31, 36);
        doc.text("1. Curriculum Modules", margin, y);
        y += 16;

        (currentCourse.modules || []).forEach((m, idx) => {
          checkAddPage(40);
          doc.setFont('helvetica', 'bold');
          doc.setFontSize(10);
          doc.setTextColor(88, 204, 2);
          doc.text(`Module 0${idx + 1}: ${m.title}`, margin, y);
          y += 14;

          doc.setFont('helvetica', 'normal');
          doc.setFontSize(8.5);
          doc.setTextColor(51, 65, 85);
          const lines = doc.splitTextToSize(m.content || "", contentWidth);
          lines.forEach(l => {
            checkAddPage(12);
            doc.text(l, margin, y);
            y += 12;
          });
          y += 6;

          if (m.summary) {
            checkAddPage(20);
            doc.setFont('helvetica', 'bold');
            doc.setFontSize(8);
            doc.setTextColor(229, 165, 0);
            const sumLines = doc.splitTextToSize(`Takeaway: ${m.summary}`, contentWidth);
            doc.text(sumLines, margin, y);
            y += (sumLines.length * 11) + 12;
          }
        });

        checkAddPage(40);
        doc.setFont('helvetica', 'bold');
        doc.setFontSize(12);
        doc.setTextColor(19, 31, 36);
        doc.text("2. Mastery Assessment & Answers", margin, y);
        y += 16;

        (currentCourse.quiz || []).forEach((q, qIdx) => {
          checkAddPage(30);
          doc.setFont('helvetica', 'bold');
          doc.setFontSize(9);
          doc.setTextColor(19, 31, 36);
          doc.text(`Q${qIdx + 1}: ${q.q}`, margin, y);
          y += 12;

          const correctOpt = q.options ? q.options[q.correct] : "";
          doc.setFont('helvetica', 'normal');
          doc.setFontSize(8.5);
          doc.setTextColor(88, 204, 2);
          doc.text(`Correct: ${correctOpt}  •  Rationale: ${q.rationale || 'Verified.'}`, margin, y);
          y += 16;
        });

        doc.save(`${(currentCourse.title || "Course").replace(/\s+/g, '_')}_Dossier.pdf`);
      } catch (err) {
        console.error(err);
      } finally {
        btn.disabled = false;
        btn.innerHTML = orig;
        lucide.createIcons();
      }
    }

    // FORGER AI TUTOR COMPANION
    function toggleForgerWindow() {
      const win = document.getElementById('forger-chat-window');
      win.classList.toggle('hidden');
      if (!win.classList.contains('hidden')) {
        document.getElementById('forger-user-input').focus();
      }
    }

    async function sendForgerMessage(prompt = null) {
      const input = document.getElementById('forger-user-input');
      const q = prompt || input.value.trim();
      if (!q) return;
      if (!prompt) input.value = '';

      const stream = document.getElementById('forger-messages-stream');
      stream.innerHTML += `<div class="bg-duo-green text-white p-3 rounded-2xl text-xs ml-auto max-w-[85%] font-bold shadow-sm">${q}</div>`;
      stream.scrollTop = stream.scrollHeight;

      const replyId = "bot-rep-" + Date.now();
      stream.innerHTML += `<div id="${replyId}" class="bg-duo-stone dark:bg-duo-darkElevated border border-duo-border dark:border-duo-darkBorder p-3 rounded-2xl text-xs max-w-[85%] font-bold">Thinking with course context...</div>`;
      stream.scrollTop = stream.scrollHeight;

      const activeMod = currentCourse?.modules?.[activeModuleIndex] || {};
      const messages = [
        {
          role: "system",
          content: `You are "Forger", a friendly tutor in an educational app like Duolingo. Course: "${currentCourse?.title || 'Masterclass'}". Lesson: "${activeMod.title || 'Overview'}". Content: "${activeMod.content || ''}". Explain intuitively with an everyday analogy in 1-2 punchy paragraphs.`
        },
        { role: "user", content: q }
      ];

      try {
        const reply = await executeGroqWithFallback(messages, false);
        document.getElementById(replyId).innerText = reply;
      } catch (e) {
        document.getElementById(replyId).innerText = "Think of parameters like dials on an audio mixer. As the track plays, backpropagation turns each dial slightly until the whole song sounds balanced!";
      }
      stream.scrollTop = stream.scrollHeight;
    }

    // POPUP MODULE PRACTICE QUESTION
    function openModuleQuizModal() {
      document.getElementById('module-quiz-modal').classList.remove('hidden');
    }

    function closeModuleQuizModal() {
      document.getElementById('module-quiz-modal').classList.add('hidden');
    }

    async function triggerModuleQuickQuiz(targetModuleIdx = null) {
      if (targetModuleIdx !== null) activeModuleIndex = targetModuleIdx;

      const mod = currentCourse?.modules?.[activeModuleIndex] || {
        title: "Active Lesson",
        content: currentCourse?.transcript || "Architecture primitives.",
        summary: "Core takeaway."
      };

      document.getElementById('modal-module-title').innerText = `Module 0${activeModuleIndex + 1}: ${mod.title}`;
      openModuleQuizModal();

      const content = document.getElementById('modal-quiz-content');
      content.innerHTML = `<div class="py-6 text-center text-xs font-black text-slate-400">Generating question...</div>`;

      await fetchModuleQuestion(mod);
    }

    function fetchAnotherModuleQuestion() {
      triggerModuleQuickQuiz(activeModuleIndex);
    }

    async function fetchModuleQuestion(moduleObj) {
      const messages = [
        {
          role: "system",
          content: "You are the Assessment Engine. Generate 1 multiple-choice practice question based strictly on the module content. Return JSON only."
        },
        {
          role: "user",
          content: `Module: "${moduleObj.title}". Content: """${moduleObj.content}""".
JSON format:
{
  "question": "Question?",
  "options": ["Option A", "Option B", "Option C"],
  "correct": 0,
  "explanation": "Why correct."
}`
        }
      ];

      try {
        const raw = await executeGroqWithFallback(messages, true);
        const parsed = parseSafeJSON(raw);
        renderModuleQuizInModal(parsed);
      } catch (err) {
        renderModuleQuizInModal({
          question: `Regarding ${moduleObj.title}: What is the core takeaway?`,
          options: [
            moduleObj.summary ? moduleObj.summary.split('.')[0] : "Weights are calibrated incrementally through loss minimization.",
            "All model weights are disconnected during inference.",
            "Parameters must be manually updated for every prompt."
          ],
          correct: 0,
          explanation: moduleObj.summary || "Parameters dictate representations via training."
        });
      }
    }

    function renderModuleQuizInModal(qData) {
      const content = document.getElementById('modal-quiz-content');
      content.innerHTML = `
        <div class="space-y-3">
          <p class="text-xs font-black text-slate-900 dark:text-white leading-snug">${qData.question}</p>
          <div class="space-y-2" id="modal-opt-container">
            ${qData.options.map((opt, oIdx) => `
              <button onclick="handleModalOptionClick(this, ${oIdx === qData.correct}, '${(qData.explanation || '').replace(/'/g, "\\'")}')" class="tactile-btn modal-opt-btn w-full text-left p-3 rounded-2xl bg-duo-stone/60 dark:bg-duo-darkElevated/50 border-2 border-b-4 border-duo-border dark:border-duo-darkBorder text-xs font-bold text-slate-700 dark:text-slate-200 transition">
                ${opt}
              </button>
            `).join('')}
          </div>
          <div id="modal-rationale" class="hidden p-3 rounded-2xl text-xs font-bold leading-relaxed"></div>
        </div>
      `;
    }

    function handleModalOptionClick(btn, isCorrect, explanation) {
      document.querySelectorAll('#modal-opt-container .modal-opt-btn').forEach(b => b.disabled = true);
      const box = document.getElementById('modal-rationale');
      box.classList.remove('hidden');

      if (isCorrect) {
        btn.classList.add('bg-duo-greenLight', 'dark:bg-duo-darkElevated', 'border-duo-green', 'text-duo-greenDark', 'dark:text-duo-green');
        box.className = "p-3 rounded-2xl text-xs font-bold bg-duo-greenLight dark:bg-duo-darkElevated text-duo-greenDark dark:text-duo-green border-2 border-b-4 border-duo-green";
        box.innerHTML = `<strong>✓ Spot on!</strong> ${explanation}`;
      } else {
        btn.classList.add('bg-duo-coralLight', 'dark:bg-duo-darkElevated', 'border-duo-coral', 'text-duo-coralDark', 'dark:text-duo-coral');
        box.className = "p-3 rounded-2xl text-xs font-bold bg-duo-coralLight dark:bg-duo-darkElevated text-duo-coralDark dark:text-duo-coral border-2 border-b-4 border-duo-coral";
        box.innerHTML = `<strong>✗ Not quite.</strong> ${explanation}`;
      }
    }

    // BACKGROUND GESTURE RECOGNITION (PRIVATE)
    function initScrollModuleObserver() {
      window.addEventListener('scroll', () => {
        document.querySelectorAll('.module-card').forEach(card => {
          const rect = card.getBoundingClientRect();
          if (rect.top <= window.innerHeight * 0.4 && rect.bottom >= window.innerHeight * 0.2) {
            activeModuleIndex = parseInt(card.getAttribute('data-module-idx')) || 0;
          }
        });
      });
    }

    async function toggleGestureDetection() {
      isGestureSenseOn = !isGestureSenseOn;
      const dot = document.getElementById('side-gesture-dot');
      const hud = document.getElementById('gesture-hud');

      if (isGestureSenseOn) {
        dot.classList.remove('hidden');
        showGestureHUD("Gestures Active in Background", 2500);
        await startMediaPipeHands();
      } else {
        dot.classList.add('hidden');
        hud.classList.add('hidden');
        stopMediaPipeHands();
      }
    }

    function showGestureHUD(text, autoHideMs = null) {
      const hud = document.getElementById('gesture-hud');
      document.getElementById('gesture-hud-text').innerText = text;
      hud.classList.remove('hidden');

      if (autoHideMs) {
        setTimeout(() => {
          if (!gestureHoldCount_Index && !gestureHoldCount_All) {
            hud.classList.add('hidden');
          }
        }, autoHideMs);
      }
    }

    async function startMediaPipeHands() {
      const videoElement = document.getElementById('webcam-video');
      handsInstance = new Hands({
        locateFile: (file) => `https://cdn.jsdelivr.net/npm/@mediapipe/hands/${file}`
      });

      handsInstance.setOptions({
        maxNumHands: 1,
        modelComplexity: 1,
        minDetectionConfidence: 0.6,
        minTrackingConfidence: 0.5
      });

      handsInstance.onResults(onHandGestureResults);

      cameraInstance = new Camera(videoElement, {
        onFrame: async () => {
          if (isGestureSenseOn) await handsInstance.send({ image: videoElement });
        },
        width: 320,
        height: 240
      });

      cameraInstance.start();
    }

    function stopMediaPipeHands() {
      if (cameraInstance) cameraInstance.stop();
    }

    function onHandGestureResults(results) {
      if (!isGestureSenseOn) return;

      const hud = document.getElementById('gesture-hud');
      const hudText = document.getElementById('gesture-hud-text');
      const progressBar = document.getElementById('gesture-progress-bar');

      if (results.multiHandLandmarks && results.multiHandLandmarks.length > 0) {
        const l = results.multiHandLandmarks[0];

        const isIndexUp = (l[8].y < l[6].y) && (l[6].y < l[5].y);
        const isMiddleUp = (l[12].y < l[10].y);
        const isRingUp = (l[16].y < l[14].y);
        const isPinkyUp = (l[20].y < l[18].y);

        const isMiddleFolded = l[12].y > l[10].y;
        const isRingFolded = l[16].y > l[14].y;
        const isPinkyFolded = l[20].y > l[18].y;

        const isOnlyIndexUp = isIndexUp && isMiddleFolded && isRingFolded && isPinkyFolded;
        const isAllFingersUp = isIndexUp && isMiddleUp && isRingUp && isPinkyUp;

        if (isOnlyIndexUp) {
          gestureHoldCount_Index++;
          gestureHoldCount_All = 0;
          hud.classList.remove('hidden');
          hudText.innerText = `☝️ Hold for analogy (${gestureHoldCount_Index}/8)`;
          progressBar.style.width = `${Math.min(100, (gestureHoldCount_Index / 8) * 100)}%`;

          if (gestureHoldCount_Index >= 8 && (Date.now() - lastGestureTriggerTime > 5000)) {
            lastGestureTriggerTime = Date.now();
            gestureHoldCount_Index = 0;
            progressBar.style.width = '0%';
            hud.classList.add('hidden');
            triggerHandRaiseExplanation();
          }
          return;
        }

        if (isAllFingersUp) {
          gestureHoldCount_All++;
          gestureHoldCount_Index = 0;
          hud.classList.remove('hidden');
          hudText.innerText = `✋ Hold for quick quiz (${gestureHoldCount_All}/8)`;
          progressBar.style.width = `${Math.min(100, (gestureHoldCount_All / 8) * 100)}%`;

          if (gestureHoldCount_All >= 8 && (Date.now() - lastGestureTriggerTime > 5000)) {
            lastGestureTriggerTime = Date.now();
            gestureHoldCount_All = 0;
            progressBar.style.width = '0%';
            hud.classList.add('hidden');
            triggerModuleQuickQuiz(activeModuleIndex);
          }
          return;
        }

        gestureHoldCount_Index = Math.max(0, gestureHoldCount_Index - 1);
        gestureHoldCount_All = Math.max(0, gestureHoldCount_All - 1);
        if (gestureHoldCount_Index === 0 && gestureHoldCount_All === 0) {
          hud.classList.add('hidden');
          progressBar.style.width = '0%';
        }
      } else {
        gestureHoldCount_Index = 0;
        gestureHoldCount_All = 0;
        hud.classList.add('hidden');
        progressBar.style.width = '0%';
      }
    }

    function triggerHandRaiseExplanation() {
      toggleForgerWindow();
      const mod = currentCourse?.modules?.[activeModuleIndex];
      const title = mod?.title || "Active Lesson";
      sendForgerMessage(`☝️ Can you explain "${title}" in a simple, intuitive way with a real-world analogy?`);
    }
  </script>
