<!DOCTYPE html>
<html lang="en" class="light">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>ExpertForge - Universal Autonomous Learning Platform</title>

  <!-- Open-Source Google Fonts: Plus Jakarta Sans + Outfit + JetBrains Mono -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600&family=Outfit:wght@400;500;600;700;800&family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />

  <!-- Tailwind CSS CDN with Custom Color & Class Dark Mode Config -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          fontFamily: {
            sans: ['"Plus Jakarta Sans"', 'system-ui', '-apple-system', 'sans-serif'],
            display: ['"Outfit"', '"Plus Jakarta Sans"', 'sans-serif'],
            mono: ['"JetBrains Mono"', 'monospace'],
          },
          colors: {
            brand: {
              50: '#f5f3ff',
              100: '#ede9fe',
              200: '#ddd6fe',
              300: '#c4b5fd',
              400: '#a78bfa',
              500: '#8b5cf6',
              600: '#7c3aed',
              700: '#6d28d9',
              800: '#5b21b6',
              900: '#4c1d95',
              950: '#2e1065',
            }
          }
        }
      }
    }
  </script>

  <!-- Lucide Icons -->
  <script src="https://unpkg.com/lucide@latest"></script>
  <!-- PDF.js for PDF slides parsing -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js"></script>
  <!-- Mammoth.js for Word DOCX parsing -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/mammoth/1.6.0/mammoth.browser.min.js"></script>
  <!-- MediaPipe Hands & Camera Utils for Gesture Detection -->
  <script src="https://cdn.jsdelivr.net/npm/@mediapipe/camera_utils/camera_utils.js" crossorigin="anonymous"></script>
  <script src="https://cdn.jsdelivr.net/npm/@mediapipe/hands/hands.js" crossorigin="anonymous"></script>
  <!-- Direct Vector jsPDF Library -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>

  <style>
    .perspective { perspective: 1000px; }
    .transform-style-preserve { transform-style: preserve-3d; }
    .rotate-y-180 { transform: rotateY(180deg); }
    .backface-hidden { backface-visibility: hidden; }

    /* Custom smooth scrollbar */
    ::-webkit-scrollbar { width: 6px; height: 6px; }
    ::-webkit-scrollbar-track { background: transparent; }
    ::-webkit-scrollbar-thumb { background: #c7d2fe; border-radius: 9999px; }
    .dark ::-webkit-scrollbar-thumb { background: #3730a3; }
  </style>
</head>
<body class="bg-[#f8f9fe] text-slate-800 dark:bg-[#090814] dark:text-slate-100 min-h-screen font-sans antialiased selection:bg-indigo-500 selection:text-white flex flex-col relative transition-colors duration-300">

  <!-- TOP NAV -->
  <header class="border-b border-indigo-100/80 dark:border-purple-950/60 bg-white/80 dark:bg-[#0e0c24]/80 backdrop-blur-xl sticky top-0 z-40 transition-colors duration-300">
    <div class="max-w-6xl mx-auto px-5 sm:px-8 h-18 py-3.5 flex items-center justify-between gap-4">
      
      <!-- Brand & Active Model Pill -->
      <div class="flex items-center space-x-3 cursor-pointer select-none" onclick="goToView('home')">
        <div class="w-10 h-10 rounded-2xl bg-gradient-to-tr from-indigo-600 via-purple-600 to-violet-500 flex items-center justify-center shadow-lg shadow-indigo-500/25 ring-2 ring-indigo-100 dark:ring-purple-900/40">
          <i data-lucide="flame" class="w-5 h-5 text-white"></i>
        </div>
        <div>
          <div class="flex items-center gap-2">
            <span class="text-xl font-extrabold tracking-tight font-display bg-gradient-to-r from-indigo-600 via-purple-600 to-violet-500 dark:from-white dark:via-purple-200 dark:to-indigo-300 bg-clip-text text-transparent">
              ExpertForge
            </span>
            <span id="active-model-tag" class="text-[10px] uppercase font-bold tracking-wider bg-purple-50 dark:bg-purple-950/60 text-purple-700 dark:text-purple-300 border border-purple-200 dark:border-purple-800/60 px-2.5 py-0.5 rounded-full font-mono">
              LLaMA-3.3-70B
            </span>
          </div>
          <p class="text-[10px] text-slate-400 dark:text-slate-400 font-medium hidden sm:block">Universal Autonomous Learning Platform</p>
        </div>
      </div>

      <!-- Actions, Gamification Badges & Theme Switch -->
      <div class="flex items-center gap-2.5 sm:gap-3.5">

        <!-- Gamification Pill (Streaks & XP) -->
        <div class="hidden md:flex items-center gap-2 bg-indigo-50/70 dark:bg-purple-950/40 border border-indigo-100 dark:border-purple-900/50 px-3 py-1.5 rounded-2xl text-xs font-semibold">
          <span class="flex items-center gap-1 text-amber-500"><i data-lucide="flame" class="w-3.5 h-3.5 fill-amber-500"></i> 7d Streak</span>
          <span class="text-slate-300 dark:text-slate-700">|</span>
          <span class="flex items-center gap-1 text-indigo-600 dark:text-indigo-400"><i data-lucide="gem" class="w-3.5 h-3.5"></i> 320 XP</span>
        </div>

        <!-- Dark Mode Toggle Button -->
        <button onclick="toggleDarkMode()" id="theme-toggle-btn" class="p-2.5 rounded-2xl bg-white dark:bg-purple-950/50 border border-indigo-100 dark:border-purple-900/60 text-slate-600 dark:text-purple-300 hover:text-indigo-600 dark:hover:text-white shadow-sm hover:shadow transition" title="Toggle Light / Dark Mode">
          <i id="theme-icon" data-lucide="moon" class="w-4 h-4"></i>
        </button>

        <!-- Dynamic Nav Actions Container -->
        <div id="nav-actions" class="flex items-center gap-2"></div>

        <!-- User Profile Avatar -->
        <div class="hidden sm:flex items-center gap-2 pl-1">
          <div class="w-9 h-9 rounded-full ring-2 ring-indigo-500/40 p-0.5 bg-gradient-to-tr from-purple-500 to-indigo-500">
            <img src="https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=100&auto=format&fit=crop&q=80" alt="Avatar" class="w-full h-full rounded-full object-cover" />
          </div>
        </div>
      </div>
    </div>
  </header>

  <!-- NON-INTRUSIVE GESTURE HUD BADGE (NO CAMERA FEED VISIBLE) -->
  <div id="gesture-hud" class="fixed top-20 left-1/2 -translate-x-1/2 z-50 hidden transition-all duration-300">
    <div class="flex items-center gap-2.5 bg-white/95 dark:bg-[#151233]/95 border border-indigo-200 dark:border-purple-800/80 px-4 py-2 rounded-full shadow-xl backdrop-blur-md">
      <div id="gesture-hud-indicator" class="w-2.5 h-2.5 rounded-full bg-emerald-500 animate-ping"></div>
      <span id="gesture-hud-text" class="text-xs font-bold text-slate-800 dark:text-slate-100 font-mono">
        ☝️ Hold detected
      </span>
      <div id="gesture-progress-bar-container" class="w-14 h-1.5 bg-slate-200 dark:bg-purple-950 rounded-full overflow-hidden">
        <div id="gesture-progress-bar" class="h-full bg-gradient-to-r from-indigo-500 to-purple-500 w-0 transition-all duration-100"></div>
      </div>
    </div>
  </div>

  <!-- MAIN CONTAINER -->
  <main class="max-w-6xl mx-auto px-5 sm:px-8 py-8 flex-1 w-full pb-32">

    <!-- VIEW 1: EDUCATIONAL OPENING -->
    <section id="view-home" class="space-y-10">
      <!-- Hero Header -->
      <div class="flex flex-col lg:flex-row items-start lg:items-center justify-between gap-6 pt-2">
        <div class="space-y-3 max-w-2xl">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-purple-100/70 dark:bg-purple-950/70 border border-purple-200 dark:border-purple-800/60 text-purple-700 dark:text-purple-300 text-xs font-bold tracking-wide">
            <i data-lucide="sparkles" class="w-3.5 h-3.5"></i>
            <span>Autonomous Masterclass Engine</span>
          </div>
          <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight font-display text-slate-900 dark:text-white leading-[1.15]">
            Invest in your <span class="bg-gradient-to-r from-indigo-600 via-purple-600 to-violet-500 bg-clip-text text-transparent">education.</span>
          </h1>
          <p class="text-slate-600 dark:text-slate-400 text-sm sm:text-base leading-relaxed">
            Upload raw audio, PDF slides, Word notes, or whiteboard sketches. Receive a 4-question adaptive diagnostic, an interactive masterclass with 3D flashcards, an architectural mindmap, background AI gestures, and vector PDF dossiers.
          </p>
        </div>

        <!-- Stat Pills -->
        <div class="grid grid-cols-3 gap-3 w-full lg:w-auto">
          <div class="bg-white dark:bg-[#13102b] border border-indigo-100 dark:border-purple-900/40 p-4 rounded-3xl text-center shadow-sm">
            <span class="text-xs text-slate-400 block font-medium">Completed</span>
            <span class="text-xl font-extrabold text-indigo-600 dark:text-indigo-400 font-display">84%</span>
          </div>
          <div class="bg-white dark:bg-[#13102b] border border-indigo-100 dark:border-purple-900/40 p-4 rounded-3xl text-center shadow-sm">
            <span class="text-xs text-slate-400 block font-medium">Lessons</span>
            <span class="text-xl font-extrabold text-purple-600 dark:text-purple-400 font-display">24/28</span>
          </div>
          <div class="bg-white dark:bg-[#13102b] border border-indigo-100 dark:border-purple-900/40 p-4 rounded-3xl text-center shadow-sm">
            <span class="text-xs text-slate-400 block font-medium">Hours</span>
            <span class="text-xl font-extrabold text-violet-600 dark:text-violet-400 font-display">42.5h</span>
          </div>
        </div>
      </div>

      <!-- Category Filter Pills -->
      <div class="flex items-center gap-2.5 overflow-x-auto pb-2 scrollbar-none">
        <button class="px-4 py-2 rounded-2xl bg-indigo-600 text-white font-semibold text-xs flex items-center gap-2 shadow-md shadow-indigo-500/20 whitespace-nowrap">
          <i data-lucide="layout-grid" class="w-3.5 h-3.5"></i> All Disciplines
        </button>
        <button class="px-4 py-2 rounded-2xl bg-white dark:bg-[#13102b] border border-indigo-100 dark:border-purple-900/40 text-slate-600 dark:text-slate-300 hover:border-indigo-400 font-medium text-xs flex items-center gap-2 whitespace-nowrap transition">
          <i data-lucide="laptop" class="w-3.5 h-3.5 text-indigo-500"></i> Computer Science & Systems
        </button>
        <button class="px-4 py-2 rounded-2xl bg-white dark:bg-[#13102b] border border-indigo-100 dark:border-purple-900/40 text-slate-600 dark:text-slate-300 hover:border-indigo-400 font-medium text-xs flex items-center gap-2 whitespace-nowrap transition">
          <i data-lucide="brain" class="w-3.5 h-3.5 text-purple-500"></i> AI & Large Language Models
        </button>
        <button class="px-4 py-2 rounded-2xl bg-white dark:bg-[#13102b] border border-indigo-100 dark:border-purple-900/40 text-slate-600 dark:text-slate-300 hover:border-indigo-400 font-medium text-xs flex items-center gap-2 whitespace-nowrap transition">
          <i data-lucide="briefcase" class="w-3.5 h-3.5 text-violet-500"></i> Engineering Leadership
        </button>
      </div>

      <!-- TWO PRIMARY ACTION CARDS -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">

        <!-- ACTION 1: FORGE A COURSE -->
        <div onclick="startForgeFlow()" class="group relative bg-gradient-to-br from-indigo-600 via-purple-600 to-violet-700 text-white p-8 rounded-[32px] cursor-pointer transition-all duration-300 hover:shadow-2xl hover:shadow-indigo-500/30 hover:-translate-y-1 overflow-hidden flex flex-col justify-between min-h-[300px]">
          <div class="absolute -right-10 -bottom-10 w-64 h-64 bg-white/10 rounded-full blur-2xl group-hover:scale-125 transition duration-500"></div>

          <div class="space-y-4 relative z-10">
            <div class="flex items-center justify-between">
              <div class="w-14 h-14 rounded-2xl bg-white/15 backdrop-blur border border-white/20 text-white flex items-center justify-center group-hover:rotate-6 transition duration-300">
                <i data-lucide="sparkles" class="w-7 h-7"></i>
              </div>
              <span class="text-[11px] font-bold uppercase tracking-wider bg-white/20 backdrop-blur px-3 py-1 rounded-full text-white border border-white/25">
                Multi-Modal Ingest
              </span>
            </div>

            <div>
              <h3 class="text-2xl font-bold font-display tracking-tight text-white">Forge a Course</h3>
              <p class="text-xs text-indigo-100 leading-relaxed mt-2 max-w-sm">
                Ingest MP3 recordings, PDF lecture decks, Word DOCX summaries, or whiteboard photos into an adaptive masterclass with AI gesture assistance.
              </p>
            </div>

            <div class="flex flex-wrap gap-2 pt-1">
              <span class="text-[10px] font-semibold bg-black/20 px-2.5 py-1 rounded-xl">🎧 Audio (Whisper)</span>
              <span class="text-[10px] font-semibold bg-black/20 px-2.5 py-1 rounded-xl">📑 PDF Slides</span>
              <span class="text-[10px] font-semibold bg-black/20 px-2.5 py-1 rounded-xl">📝 DOCX Notes</span>
              <span class="text-[10px] font-semibold bg-black/20 px-2.5 py-1 rounded-xl">🖼️ Whiteboards</span>
            </div>
          </div>

          <div class="pt-6 relative z-10 flex items-center justify-between border-t border-white/15">
            <span class="text-xs font-semibold tracking-wide text-indigo-100 flex items-center gap-1.5">
              Launch Diagnostic Wizard
            </span>
            <div class="w-9 h-9 rounded-full bg-white text-indigo-600 flex items-center justify-center group-hover:translate-x-1 transition shadow">
              <i data-lucide="arrow-right" class="w-4 h-4"></i>
            </div>
          </div>
        </div>

        <!-- ACTION 2: VIEW SAVED COURSES -->
        <div onclick="goToView('courses')" class="group bg-white dark:bg-[#13102b] border border-indigo-100 dark:border-purple-900/40 p-8 rounded-[32px] cursor-pointer transition-all duration-300 hover:border-purple-400 dark:hover:border-purple-500 hover:shadow-xl hover:shadow-purple-500/10 hover:-translate-y-1 flex flex-col justify-between min-h-[300px]">
          <div class="space-y-4">
            <div class="flex items-center justify-between">
              <div class="w-14 h-14 rounded-2xl bg-purple-50 dark:bg-purple-950/60 border border-purple-100 dark:border-purple-900/60 text-purple-600 dark:text-purple-400 flex items-center justify-center group-hover:scale-110 transition duration-300">
                <i data-lucide="book-open" class="w-7 h-7"></i>
              </div>
              <span class="text-[11px] font-bold uppercase tracking-wider bg-indigo-50 dark:bg-purple-950/40 text-indigo-600 dark:text-indigo-400 border border-indigo-100 dark:border-purple-900/50 px-3 py-1 rounded-full">
                Saved Repository
              </span>
            </div>

            <div>
              <h3 class="text-2xl font-bold font-display tracking-tight text-slate-900 dark:text-white group-hover:text-purple-600 dark:group-hover:text-purple-400 transition">Course Library</h3>
              <p class="text-xs text-slate-500 dark:text-slate-400 leading-relaxed mt-2 max-w-sm">
                Revisit calibrated courses, practice interactive 3D flashcards, inspect conceptual mindmaps, trigger module practice MCQs, and export PDF dossiers.
              </p>
            </div>

            <div class="p-3.5 rounded-2xl bg-indigo-50/50 dark:bg-purple-950/30 border border-indigo-100 dark:border-purple-900/30 flex items-center justify-between text-xs">
              <div class="flex items-center gap-2">
                <div class="w-2 h-2 rounded-full bg-emerald-500 animate-ping"></div>
                <span class="text-slate-600 dark:text-slate-300 font-medium">Ready for Revision</span>
              </div>
              <span class="font-bold text-indigo-600 dark:text-purple-400">PDF & Canvas Enabled</span>
            </div>
          </div>

          <div class="pt-6 flex items-center justify-between border-t border-slate-100 dark:border-purple-900/30">
            <span class="text-xs font-semibold text-slate-700 dark:text-slate-300 group-hover:text-indigo-600 dark:group-hover:text-purple-400 transition">
              Browse Course Catalog
            </span>
            <div class="w-9 h-9 rounded-full bg-slate-100 dark:bg-purple-900/50 text-slate-600 dark:text-slate-300 group-hover:bg-indigo-600 group-hover:text-white transition flex items-center justify-center shadow-sm">
              <i data-lucide="arrow-right" class="w-4 h-4"></i>
            </div>
          </div>
        </div>

      </div>

      <!-- INSPIRATION SECTION -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 pt-2">
        <div class="bg-white dark:bg-[#13102b] border border-indigo-100 dark:border-purple-900/40 p-6 rounded-3xl space-y-4 shadow-sm">
          <div class="flex items-center justify-between">
            <span class="text-xs font-bold uppercase tracking-wider text-slate-400 font-display">Study Activity</span>
            <span class="text-[11px] font-semibold text-indigo-600 dark:text-purple-400 bg-indigo-50 dark:bg-purple-950/50 px-2.5 py-0.5 rounded-full">This Week</span>
          </div>
          <div class="flex items-baseline gap-2">
            <span class="text-2xl font-extrabold text-slate-900 dark:text-white font-display">4.8h</span>
            <span class="text-xs text-emerald-500 font-semibold">👍 Top 5% Focus</span>
          </div>

          <div class="flex items-end justify-between h-24 pt-4 px-1">
            <div class="flex flex-col items-center gap-1.5"><div class="w-4 h-12 bg-indigo-200 dark:bg-purple-900/60 rounded-full"></div><span class="text-[10px] text-slate-400">M</span></div>
            <div class="flex flex-col items-center gap-1.5"><div class="w-4 h-16 bg-indigo-300 dark:bg-purple-800/80 rounded-full"></div><span class="text-[10px] text-slate-400">T</span></div>
            <div class="flex flex-col items-center gap-1.5"><div class="w-4 h-10 bg-indigo-200 dark:bg-purple-900/60 rounded-full"></div><span class="text-[10px] text-slate-400">W</span></div>
            <div class="flex flex-col items-center gap-1.5"><div class="w-4 h-20 bg-purple-400 dark:bg-purple-600 rounded-full"></div><span class="text-[10px] text-slate-400">T</span></div>
            <div class="flex flex-col items-center gap-1.5"><div class="w-4 h-14 bg-indigo-300 dark:bg-purple-800/80 rounded-full"></div><span class="text-[10px] text-slate-400">F</span></div>
            <div class="flex flex-col items-center gap-1.5"><div class="w-4 h-22 bg-gradient-to-t from-indigo-600 to-purple-600 rounded-full ring-2 ring-indigo-400/40"></div><span class="text-[10px] font-bold text-indigo-600 dark:text-purple-400">S</span></div>
            <div class="flex flex-col items-center gap-1.5"><div class="w-4 h-8 bg-indigo-100 dark:bg-purple-950 rounded-full"></div><span class="text-[10px] text-slate-400">S</span></div>
          </div>
        </div>

        <div class="bg-white dark:bg-[#13102b] border border-indigo-100 dark:border-purple-900/40 p-6 rounded-3xl space-y-4 shadow-sm">
          <div class="flex items-center justify-between">
            <span class="text-xs font-bold uppercase tracking-wider text-slate-400 font-display">Dual Gesture Sense</span>
            <span class="text-xs font-mono text-purple-600 dark:text-purple-400">Background Cam</span>
          </div>

          <div class="grid grid-cols-2 gap-2 pt-2 text-center">
            <div class="p-3 rounded-2xl bg-indigo-50/70 dark:bg-purple-950/40 border border-indigo-100 dark:border-purple-900/30 flex flex-col items-center gap-1">
              <span class="text-2xl">☝️</span>
              <span class="text-[10px] font-bold text-slate-700 dark:text-slate-200">Index Up</span>
              <span class="text-[9px] text-slate-400">Explain Lesson</span>
            </div>
            <div class="p-3 rounded-2xl bg-purple-50/70 dark:bg-purple-950/40 border border-purple-100 dark:border-purple-900/30 flex flex-col items-center gap-1">
              <span class="text-2xl">✋</span>
              <span class="text-[10px] font-bold text-slate-700 dark:text-slate-200">Open Hand</span>
              <span class="text-[9px] text-slate-400">Module MCQ Quiz</span>
            </div>
          </div>

          <p class="text-[11px] text-slate-500 dark:text-slate-400 leading-snug pt-1">
            Gestures run privately in the background without displaying video.
          </p>
        </div>

        <div class="bg-white dark:bg-[#13102b] border border-indigo-100 dark:border-purple-900/40 p-6 rounded-3xl space-y-3.5 shadow-sm">
          <div class="flex items-center justify-between">
            <span class="text-xs font-bold uppercase tracking-wider text-slate-400 font-display">System Radar</span>
            <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
          </div>
          <div class="space-y-2 text-xs">
            <div class="flex items-center justify-between p-2 rounded-xl bg-slate-50 dark:bg-purple-950/30 border border-slate-100 dark:border-purple-900/20">
              <span class="text-slate-600 dark:text-slate-400 flex items-center gap-1.5"><i data-lucide="mic" class="w-3.5 h-3.5 text-indigo-500"></i> Whisper Audio v3</span>
              <span class="text-emerald-500 font-mono font-bold">Online</span>
            </div>
            <div class="flex items-center justify-between p-2 rounded-xl bg-slate-50 dark:bg-purple-950/30 border border-slate-100 dark:border-purple-900/20">
              <span class="text-slate-600 dark:text-slate-400 flex items-center gap-1.5"><i data-lucide="hand" class="w-3.5 h-3.5 text-purple-500"></i> MediaPipe Hands</span>
              <span class="text-emerald-500 font-mono font-bold">Private Cam</span>
            </div>
            <div class="flex items-center justify-between p-2 rounded-xl bg-slate-50 dark:bg-purple-950/30 border border-slate-100 dark:border-purple-900/20">
              <span class="text-slate-600 dark:text-slate-400 flex items-center gap-1.5"><i data-lucide="cpu" class="w-3.5 h-3.5 text-violet-500"></i> LLaMA-3.3-70B</span>
              <span class="text-indigo-600 dark:text-indigo-400 font-mono font-bold">Active</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- VIEW 2: MULTIMODAL FORGE WIZARD -->
    <section id="view-forge" class="hidden max-w-2xl mx-auto space-y-6">
      <button onclick="goToView('home')" class="text-xs font-semibold text-slate-500 dark:text-slate-400 hover:text-indigo-600 dark:hover:text-white flex items-center gap-1.5 transition">
        <i data-lucide="arrow-left" class="w-3.5 h-3.5"></i> Back to Dashboard
      </button>

      <!-- Upload Step -->
      <div id="forge-step-upload" class="bg-white dark:bg-[#13102b] border border-indigo-100 dark:border-purple-900/40 rounded-[32px] p-8 sm:p-10 space-y-6 shadow-xl">
