    // STUDY TABS
    function setStudyTab(tab) {
      ['overview', 'modules', 'flashcards', 'quiz', 'mindmap'].forEach(t => {
        document.getElementById(`study-tab-${t}`).classList.toggle('hidden', t !== tab);
        const btn = document.getElementById(`study-tab-btn-${t}`);
        if (btn) {
          btn.className = (t === tab)
            ? "pb-3 border-b-2 border-indigo-600 dark:border-purple-400 text-indigo-600 dark:text-purple-400 transition flex items-center gap-2 whitespace-nowrap font-bold"
            : "pb-3 border-b-2 border-transparent text-slate-500 dark:text-slate-400 hover:text-slate-900 dark:hover:text-slate-200 transition flex items-center gap-2 whitespace-nowrap";
        }
      });
      lucide.createIcons();
      window.scrollTo({ top: 0, behavior: 'smooth' });

      if (tab === 'mindmap' && currentCourse) {
        setTimeout(() => renderMindmapCanvas(currentCourse), 50);
      }
    }

    // FLASHCARD & QUIZ ACTIONS
    function flipSingleCard(cardContainer) {
      const inner = cardContainer.querySelector('.card-inner');
      inner.classList.toggle('rotate-y-180');
    }

    function flipAllCards() {
      allCardsFlipped = !allCardsFlipped;
      document.querySelectorAll('#flashcards-grid .card-inner').forEach(inner => {
        inner.classList.toggle('rotate-y-180', allCardsFlipped);
      });
    }

    function handleQuizOptionClick(btn, isCorrect, rationale) {
      const card = btn.closest('.quiz-card');
      if (card.getAttribute('data-answered') === 'true') return;
      card.setAttribute('data-answered', 'true');

      const box = card.querySelector('.rationale-box');
      box.classList.remove('hidden');
      box.innerHTML = `<strong>${isCorrect ? 'Correct!' : 'Incorrect.'}</strong> ${rationale}`;

      btn.classList.remove('bg-slate-50', 'dark:bg-[#0c0b1e]', 'border-indigo-100/70', 'text-slate-700');
      if (isCorrect) {
        btn.classList.add('bg-emerald-50', 'dark:bg-emerald-950/70', 'border-emerald-500', 'text-emerald-700', 'dark:text-emerald-300');
      } else {
        btn.classList.add('bg-rose-50', 'dark:bg-rose-950/70', 'border-rose-500', 'text-rose-700', 'dark:text-rose-300');
      }

      updateQuizScoreTally();
      lucide.createIcons();
    }

    function updateQuizScoreTally() {
      const answered = document.querySelectorAll('.quiz-card[data-answered="true"]');
      let correct = 0;
      answered.forEach(c => {
        if (c.querySelector('.bg-emerald-50') || c.querySelector('.dark\\:bg-emerald-950\\/70')) correct++;
      });

      if (answered.length > 0) {
        const badge = document.getElementById('quiz-score-badge');
        badge.classList.remove('hidden');
        badge.innerText = `Score: ${correct} / ${answered.length} (${Math.round((correct/answered.length)*100)}%)`;
      }
    }

    // THEME-AWARE MINDMAP CANVAS
    function renderMindmapCanvas(course) {
      const canvas = document.getElementById('mindmap-canvas');
      if (!canvas) return;

      const ctx = canvas.getContext('2d');
      const isDark = document.documentElement.classList.contains('dark');

      let branches = [];
      if (course.mindmap && course.mindmap.branches && course.mindmap.branches.length > 0) {
        branches = course.mindmap.branches.map(b => ({
          label: b.label || "Core Module",
          objective: b.objective || "Pillar Objective",
          subnodes: (b.subnodes || []).map(s => {
            if (typeof s === 'string') return { title: s, desc: "Key operational principle." };
            return { title: s.title || "Concept", desc: s.desc || "Operational mechanism." };
          })
        }));
      } else {
        branches = (course.modules || []).map(m => ({
          label: m.title.replace(/^Pillar \d+:|^Module \d+:/i, '').trim(),
          objective: "Operational Architecture",
          subnodes: [
            { title: "Core Mechanism", desc: "Numerical parameters adjusted incrementally via loss gradients." },
            { title: "Engineering Rule", desc: "Quantization preserves perplexity while slashing VRAM." }
          ]
        }));
      }

      let totalLeaves = 0;
      branches.forEach(b => {
        totalLeaves += (b.subnodes && b.subnodes.length > 0 ? b.subnodes.length : 1);
      });

      const width = 1380;
      const leafCardHeight = 84;
      const leafGap = 26;
      const height = Math.max(750, totalLeaves * (leafCardHeight + leafGap) + 180);
      const dpr = window.devicePixelRatio || 2;

      canvas.width = width * dpr;
      canvas.height = height * dpr;
      canvas.style.width = `${width}px`;
      canvas.style.height = `${height}px`;

      ctx.scale(dpr, dpr);

      ctx.fillStyle = isDark ? '#0b091e' : '#f8f9fe';
      ctx.fillRect(0, 0, width, height);

      ctx.fillStyle = isDark ? '#272052' : '#e0e7ff';
      for (let x = 24; x < width; x += 32) {
        for (let y = 24; y < height; y += 32) {
          ctx.beginPath();
          ctx.arc(x, y, 1, 0, Math.PI * 2);
          ctx.fill();
        }
      }

      const branchColors = [
        { stroke: '#6366f1', fill: isDark ? '#1b1747' : '#eef2ff', text: isDark ? '#a5b4fc' : '#4338ca', border: '#6366f1', pill: '#818cf8' },
        { stroke: '#8b5cf6', fill: isDark ? '#261453' : '#f3e8ff', text: isDark ? '#d8b4fe' : '#6b21a8', border: '#8b5cf6', pill: '#a855f7' },
        { stroke: '#10b981', fill: isDark ? '#063f31' : '#ecfdf5', text: isDark ? '#6ee7b7' : '#047857', border: '#10b981', pill: '#34d399' }
      ];

      const rootX = 170;
      const rootY = height / 2;
      const col2X = 540;
      const col3X = 940;
      const leafCardWidth = 380;

      ctx.font = 'bold 11px system-ui, sans-serif';
      ctx.fillStyle = isDark ? '#a5b4fc' : '#4f46e5';
      ctx.fillText('EXPERTFORGE AUTONOMOUS REVISION BLUEPRINT', 44, 42);

      ctx.font = '10px monospace';
      ctx.fillStyle = isDark ? '#64748b' : '#94a3b8';
      ctx.fillText(`Target Track: ${course.level || 'Apprentice'} • Generated: ${new Date().toLocaleDateString()} • Verified Schema`, 44, 58);

      let currentLeafY = 90;

      branches.forEach((branch, bIdx) => {
        const color = branchColors[bIdx % branchColors.length];
        const subnodes = branch.subnodes || [];

        const branchStartY = currentLeafY;
        const branchHeight = subnodes.length * (leafCardHeight + leafGap);
        const branchY = branchStartY + branchHeight / 2 - leafGap / 2;

        ctx.beginPath();
        ctx.moveTo(rootX + 120, rootY);
        ctx.bezierCurveTo(rootX + 280, rootY, col2X - 90, branchY, col2X, branchY);
        ctx.strokeStyle = color.stroke;
        ctx.lineWidth = 2.5;
        ctx.stroke();

        const modBoxWidth = 230;
        const modBoxHeight = 68;
        drawRoundedRect(ctx, col2X - 10, branchY - modBoxHeight / 2, modBoxWidth, modBoxHeight, 14, color.fill, color.border);

        ctx.font = 'bold 9px system-ui, sans-serif';
        ctx.fillStyle = color.pill;
        ctx.fillText(`PILLAR 0${bIdx + 1}`, col2X + 12, branchY - 14);

        ctx.font = 'bold 12px system-ui, sans-serif';
        ctx.fillStyle = isDark ? '#ffffff' : '#0f172a';
        ctx.fillText(truncateText(ctx, branch.label, 200), col2X + 12, branchY + 4);

        ctx.font = '9px system-ui, sans-serif';
        ctx.fillStyle = isDark ? '#94a3b8' : '#64748b';
        ctx.fillText(truncateText(ctx, branch.objective || "Operational Architecture", 200), col2X + 12, branchY + 20);

        subnodes.forEach((leaf) => {
          const cardCenterY = currentLeafY + leafCardHeight / 2;

          ctx.beginPath();
          ctx.moveTo(col2X + modBoxWidth - 10, branchY);
          ctx.bezierCurveTo(col2X + modBoxWidth + 80, branchY, col3X - 70, cardCenterY, col3X, cardCenterY);
          ctx.strokeStyle = color.stroke + '70';
          ctx.lineWidth = 1.6;
          ctx.stroke();

          drawRoundedRect(ctx, col3X, currentLeafY, leafCardWidth, leafCardHeight, 12, isDark ? '#141033' : '#ffffff', isDark ? color.border + '80' : '#e2e8f0');

          ctx.fillStyle = color.stroke;
          ctx.beginPath();
          ctx.roundRect(col3X, currentLeafY, 4, leafCardHeight, [12, 0, 0, 12]);
          ctx.fill();

          ctx.font = 'bold 11px system-ui, sans-serif';
          ctx.fillStyle = isDark ? '#ffffff' : '#0f172a';
          ctx.fillText(truncateText(ctx, leaf.title, 340), col3X + 16, currentLeafY + 20);

          ctx.fillStyle = color.pill;
          ctx.beginPath();
          ctx.arc(col3X + leafCardWidth - 16, currentLeafY + 16, 3, 0, Math.PI * 2);
          ctx.fill();

          ctx.font = '10px system-ui, sans-serif';
          ctx.fillStyle = isDark ? '#94a3b8' : '#475569';
          wrapCanvasText(ctx, leaf.desc, col3X + 16, currentLeafY + 38, leafCardWidth - 32, 14, 3);

          currentLeafY += leafCardHeight + leafGap;
        });
      });

      const rootW = 240;
      const rootH = 80;
      drawRoundedRect(ctx, rootX - rootW / 2, rootY - rootH / 2, rootW, rootH, 16, isDark ? '#1c164a' : '#4f46e5', '#818cf8');

      ctx.fillStyle = isDark ? '#c7d2fe' : '#e0e7ff';
      ctx.font = 'bold 9px system-ui, sans-serif';
      ctx.fillText('MASTERCLASS BLUEPRINT CORE', rootX - rootW / 2 + 18, rootY - 18);

      ctx.fillStyle = '#ffffff';
      ctx.font = 'bold 13px system-ui, sans-serif';
      ctx.fillText(truncateText(ctx, course.title, rootW - 36), rootX - rootW / 2 + 18, rootY + 4);

      const thesis = course.mindmap?.centralThesis || "Core systems architecture & operational primitives.";
      ctx.font = '9px system-ui, sans-serif';
      ctx.fillStyle = isDark ? '#cbd5e1' : '#e0e7ff';
      ctx.fillText(truncateText(ctx, thesis, rootW - 36), rootX - rootW / 2 + 18, rootY + 22);
    }

    function wrapCanvasText(ctx, text, x, y, maxWidth, lineHeight, maxLines) {
      if (!text) return;
      const words = text.split(' ');
      let line = '';
      let currentY = y;
      let lineCount = 1;

      for (let n = 0; n < words.length; n++) {
        const testLine = line + words[n] + ' ';
        const metrics = ctx.measureText(testLine);
        if (metrics.width > maxWidth && n > 0) {
          if (lineCount >= maxLines) {
            ctx.fillText(line.trim() + '...', x, currentY);
            return;
          }
          ctx.fillText(line, x, currentY);
          line = words[n] + ' ';
          currentY += lineHeight;
          lineCount++;
        } else {
          line = testLine;
        }
      }
      ctx.fillText(line, x, currentY);
    }

    function drawRoundedRect(ctx, x, y, width, height, radius, fill, stroke) {
      ctx.beginPath();
      ctx.moveTo(x + radius, y);
      ctx.lineTo(x + width - radius, y);
      ctx.quadraticCurveTo(x + width, y, x + width, y + radius);
      ctx.lineTo(x + width, y + height - radius);
      ctx.quadraticCurveTo(x + width, y + height, x + width - radius, y + height);
      ctx.lineTo(x + radius, y + height);
      ctx.quadraticCurveTo(x, y + height, x, y + height - radius);
      ctx.lineTo(x, y + radius);
      ctx.quadraticCurveTo(x, y, x + radius, y);
      ctx.closePath();

      if (fill) {
        ctx.fillStyle = fill;
        ctx.fill();
      }
      if (stroke) {
        ctx.strokeStyle = stroke;
        ctx.lineWidth = 1.5;
        ctx.stroke();
      }
    }

    function truncateText(ctx, text, maxWidth) {
      if (!text) return '';
      if (ctx.measureText(text).width <= maxWidth) return text;
      let truncated = text;
      while (ctx.measureText(truncated + '...').width > maxWidth && truncated.length > 0) {
        truncated = truncated.slice(0, -1);
      }
      return truncated + '...';
    }

