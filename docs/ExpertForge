    // THEME-AWARE TACTILE CANVAS MINDMAP (NO PURPLE/INDIGO)
    function renderMindmapCanvas(course) {
      const canvas = document.getElementById('mindmap-canvas');
      if (!canvas) return;

      const ctx = canvas.getContext('2d');
      const isDark = document.documentElement.classList.contains('dark');

      const branches = (course.mindmap?.branches || []).length > 0
        ? course.mindmap.branches
        : (course.modules || []).map(m => ({
            label: m.title,
            objective: "Architecture Objective",
            subnodes: [
              { title: "Core Mechanism", desc: "Numerical parameters adjusted incrementally via loss gradients." },
              { title: "Tactile Rule", desc: "Quantization preserves multi-step reasoning while slashing VRAM." }
            ]
          }));

      let totalLeaves = 0;
      branches.forEach(b => {
        totalLeaves += (b.subnodes?.length || 1);
      });

      const width = 1200;
      const leafHeight = 72;
      const leafGap = 22;
      const height = Math.max(600, totalLeaves * (leafHeight + leafGap) + 120);
      const dpr = window.devicePixelRatio || 2;

      canvas.width = width * dpr;
      canvas.height = height * dpr;
      canvas.style.width = `${width}px`;
      canvas.style.height = `${height}px`;

      ctx.scale(dpr, dpr);

      // Canvas background
      ctx.fillStyle = isDark ? '#131f24' : '#f5efe6';
      ctx.fillRect(0, 0, width, height);

      const branchColors = [
        { stroke: '#58cc02', fill: isDark ? '#1b272d' : '#fffcf7', text: isDark ? '#ffffff' : '#131f24', border: '#46a302' },
        { stroke: '#ffc800', fill: isDark ? '#1b272d' : '#fffcf7', text: isDark ? '#ffffff' : '#131f24', border: '#e5a500' },
        { stroke: '#1cb0f6', fill: isDark ? '#1b272d' : '#fffcf7', text: isDark ? '#ffffff' : '#131f24', border: '#1899d6' }
      ];

      const rootX = 140;
      const rootY = height / 2;
      const col2X = 460;
      const col3X = 800;
      const leafWidth = 360;

      let currentLeafY = 60;

      branches.forEach((branch, bIdx) => {
        const color = branchColors[bIdx % branchColors.length];
        const subnodes = branch.subnodes || [];
        const branchStartY = currentLeafY;
        const branchHeight = subnodes.length * (leafHeight + leafGap);
        const branchY = branchStartY + branchHeight / 2 - leafGap / 2;

        ctx.beginPath();
        ctx.moveTo(rootX + 90, rootY);
        ctx.bezierCurveTo(rootX + 220, rootY, col2X - 60, branchY, col2X, branchY);
        ctx.strokeStyle = color.stroke;
        ctx.lineWidth = 3;
        ctx.stroke();

        drawRoundedRect(ctx, col2X - 5, branchY - 26, 210, 52, 12, color.fill, color.border);
        ctx.font = 'bold 11px system-ui, sans-serif';
        ctx.fillStyle = color.text;
        ctx.fillText(truncateText(ctx, branch.label || `Pillar ${bIdx+1}`, 180), col2X + 12, branchY + 4);

        subnodes.forEach(leaf => {
          const cardCenterY = currentLeafY + leafHeight / 2;
          ctx.beginPath();
          ctx.moveTo(col2X + 205, branchY);
          ctx.bezierCurveTo(col2X + 280, branchY, col3X - 50, cardCenterY, col3X, cardCenterY);
          ctx.strokeStyle = color.stroke;
          ctx.lineWidth = 2;
          ctx.stroke();

          drawRoundedRect(ctx, col3X, currentLeafY, leafWidth, leafHeight, 10, isDark ? '#1b272d' : '#fffcf7', isDark ? '#28383f' : '#e5decb');

          ctx.fillStyle = color.stroke;
          ctx.beginPath();
          ctx.roundRect(col3X, currentLeafY, 5, leafHeight, [10, 0, 0, 10]);
          ctx.fill();

          ctx.font = 'bold 11px system-ui, sans-serif';
          ctx.fillStyle = isDark ? '#ffffff' : '#131f24';
          ctx.fillText(truncateText(ctx, leaf.title || "Concept", 320), col3X + 16, currentLeafY + 20);

          ctx.font = '10px system-ui, sans-serif';
          ctx.fillStyle = isDark ? '#94a3b8' : '#64748b';
          wrapCanvasText(ctx, leaf.desc || "", col3X + 16, currentLeafY + 36, leafWidth - 28, 13, 2);

          currentLeafY += leafHeight + leafGap;
        });
      });

      // Central Hub
      drawRoundedRect(ctx, rootX - 80, rootY - 32, 160, 64, 16, '#58cc02', '#46a302');
      ctx.fillStyle = '#ffffff';
      ctx.font = 'bold 12px system-ui, sans-serif';
      ctx.fillText(truncateText(ctx, course.title || "Core Syllabus", 130), rootX - 68, rootY + 4);
    }

    function wrapCanvasText(ctx, text, x, y, maxWidth, lineHeight, maxLines) {
      if (!text) return;
      const words = text.split(' ');
      let line = '';
      let currentY = y;
      let lineCount = 1;

      for (let n = 0; n < words.length; n++) {
        const testLine = line + words[n] + ' ';
        if (ctx.measureText(testLine).width > maxWidth && n > 0) {
          if (lineCount >= maxLines) {
            ctx.fillText(line.trim() + '...', x, currentY);
            return;
          }
          ctx.fillText(line, x, currentY);
          line = words[n] + ' ';
          currentY += lineHeight;
          lineCount++;
        } else {
          line = testLine;
        }
      }
      ctx.fillText(line, x, currentY);
    }

    function drawRoundedRect(ctx, x, y, width, height, radius, fill, stroke) {
      ctx.beginPath();
      ctx.moveTo(x + radius, y);
      ctx.lineTo(x + width - radius, y);
      ctx.quadraticCurveTo(x + width, y, x + width, y + radius);
      ctx.lineTo(x + width, y + height - radius);
      ctx.quadraticCurveTo(x + width, y + height, x + width - radius, y + height);
      ctx.lineTo(x + radius, y + height);
      ctx.quadraticCurveTo(x, y + height, x, y + height - radius);
      ctx.lineTo(x, y + radius);
      ctx.quadraticCurveTo(x, y, x + radius, y);
      ctx.closePath();
      if (fill) { ctx.fillStyle = fill; ctx.fill(); }
      if (stroke) { ctx.strokeStyle = stroke; ctx.lineWidth = 2; ctx.stroke(); }
    }

    function truncateText(ctx, text, maxWidth) {
      if (!text) return '';
      if (ctx.measureText(text).width <= maxWidth) return text;
      let truncated = text;
      while (ctx.measureText(truncated + '...').width > maxWidth && truncated.length > 0) {
        truncated = truncated.slice(0, -1);
      }
      return truncated + '...';
    }

