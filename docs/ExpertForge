    ];

    window.addEventListener("DOMContentLoaded", () => {
      initTheme();
      lucide.createIcons();
      initStorage();
      renderCourseLibrary();
      initScrollModuleObserver();
    });

    // THEME CONTROLLER
    function initTheme() {
      const savedTheme = localStorage.getItem("ef_theme") || "light";
      const isDark = savedTheme === "dark";
      document.documentElement.classList.toggle("dark", isDark);
      updateThemeIcon(isDark);
    }

    function toggleDarkMode() {
      const isDark = document.documentElement.classList.toggle("dark");
      localStorage.setItem("ef_theme", isDark ? "dark" : "light");
      updateThemeIcon(isDark);
      redrawMindmap();
    }

    function updateThemeIcon(isDark) {
      const icon = document.getElementById("theme-icon");
      if (icon) {
        icon.setAttribute("data-lucide", isDark ? "sun" : "moon");
        lucide.createIcons();
      }
    }

    function initStorage() {
      if (!localStorage.getItem("ef_courses")) {
        localStorage.setItem("ef_courses", JSON.stringify([]));
      }
    }

    function getSavedCourses() {
      return JSON.parse(localStorage.getItem("ef_courses") || "[]");
    }

    function saveCourseToStorage(course) {
      const courses = getSavedCourses();
      const existingIdx = courses.findIndex(c => c.id === course.id);
      if (existingIdx >= 0) courses[existingIdx] = course;
      else courses.unshift(course);
      localStorage.setItem("ef_courses", JSON.stringify(courses));
    }

    // VIEW ROUTER
    function goToView(viewName) {
      ['home', 'forge', 'courses', 'course-study'].forEach(v => {
        const el = document.getElementById(`view-${v}`);
        if (el) el.classList.toggle('hidden', v !== viewName);
      });

      // Side Nav Active Styling
      ['home', 'forge', 'courses'].forEach(btn => {
        const b = document.getElementById(`nav-btn-${btn}`);
        if (b) {
          if (btn === viewName || (btn === 'courses' && viewName === 'course-study')) {
            b.classList.add('bg-duo-green', 'border-duo-greenDark', 'text-white');
            b.classList.remove('bg-duo-stone', 'dark:bg-duo-darkElevated', 'text-slate-600', 'dark:text-slate-300');
          } else {
            b.classList.remove('bg-duo-green', 'border-duo-greenDark', 'text-white');
            b.classList.add('bg-duo-stone', 'dark:bg-duo-darkElevated', 'text-slate-600', 'dark:text-slate-300');
          }
        }
      });

      lucide.createIcons();
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    function startForgeFlow() {
      goToView('forge');
      setForgeStep('upload');
      document.getElementById('upload-filename-display').innerText = "Accepts MP3, WAV, PDF, DOCX, TXT, PNG, JPG";
      document.getElementById('universal-file-input').value = "";
    }

    function setForgeStep(step) {
      ['upload', 'processing', 'pretest'].forEach(s => {
        document.getElementById(`forge-step-${s}`).classList.toggle('hidden', s !== step);
      });
      lucide.createIcons();
    }

    // MULTIMODAL INGESTION
    async function handleUniversalUpload(event) {
      const file = event.target.files[0];
      if (!file) return;

      const fileName = file.name;
      const ext = fileName.split('.').pop().toLowerCase();
      document.getElementById('upload-filename-display').innerText = `Selected: ${fileName}`;
      setForgeStep('processing');

      try {
        if (['mp3', 'wav', 'm4a', 'aac', 'ogg'].includes(ext)) {
          document.getElementById('processing-title').innerText = "Transcribing Speech...";
          document.getElementById('processing-subtitle').innerText = "Streaming speech directly to Groq Whisper Large v3...";
          currentExtractedText = await transcribeAudioWithWhisper(file);
        } else if (ext === 'pdf') {
          document.getElementById('processing-title').innerText = "Parsing PDF Slides...";
          document.getElementById('processing-subtitle').innerText = "Extracting slide pages via PDF.js...";
          currentExtractedText = await extractPdfText(file);
        } else if (ext === 'docx') {
          document.getElementById('processing-title').innerText = "Parsing Word Notes...";
          document.getElementById('processing-subtitle').innerText = "Extracting document structure via Mammoth.js...";
          currentExtractedText = await extractDocxText(file);
        } else if (['png', 'jpg', 'jpeg', 'webp'].includes(ext)) {
          document.getElementById('processing-title').innerText = "Analyzing Diagram Image...";
          document.getElementById('processing-subtitle').innerText = "Extracting visual notes via Groq Vision...";
          currentExtractedText = await extractImageWithVision(file);
        } else {
          currentExtractedText = await file.text();
        }

        if (!currentExtractedText || currentExtractedText.trim().length < 30) {
          throw new Error("Content too short.");
        }

        const preview = document.getElementById('processing-transcript-preview');
        preview.classList.remove('hidden');
        preview.innerText = currentExtractedText.substring(0, 260) + "...";

        await generateDiagnosticFromTranscript(currentExtractedText);
      } catch (err) {
        console.warn("Upload fallback to sample:", err);
        loadDemoLecture('slides');
      }
    }

    async function transcribeAudioWithWhisper(file) {
      const formData = new FormData();
      formData.append("file", file);
      formData.append("model", "whisper-large-v3");

      const response = await fetch("https://api.groq.com/openai/v1/audio/transcriptions", {
        method: "POST",
        headers: { "Authorization": `Bearer ${GROQ_API_KEY}` },
        body: formData
      });
      const data = await response.json();
      if (!response.ok) throw new Error(data.error?.message || "Transcription failed");
      return data.text;
    }

    async function extractPdfText(file) {
      const arrayBuffer = await file.arrayBuffer();
      const pdf = await pdfjsLib.getDocument({ data: arrayBuffer }).promise;
      let fullText = "";
      for (let i = 1; i <= pdf.numPages; i++) {
        const page = await pdf.getPage(i);
        const textContent = await page.getTextContent();
        fullText += `[Slide ${i}]: ` + textContent.items.map(item => item.str).join(' ') + "\n\n";
      }
      return fullText;
    }

    async function extractDocxText(file) {
      const arrayBuffer = await file.arrayBuffer();
      const result = await mammoth.extractRawText({ arrayBuffer });
      return result.value;
    }

    async function extractImageWithVision(file) {
      const base64Data = await new Promise((resolve) => {
        const reader = new FileReader();
        reader.onload = () => resolve(reader.result);
        reader.readAsDataURL(file);
      });

      const res = await fetch("https://api.groq.com/openai/v1/chat/completions", {
        method: "POST",
        headers: {
          "Authorization": `Bearer ${GROQ_API_KEY}`,
          "Content-Type": "application/json"
        },
        body: JSON.stringify({
          model: "llama-3.2-11b-vision-preview",
          messages: [
            {
              role: "user",
              content: [
                { type: "text", text: "Transcribe all technical concepts, formulas, and architecture diagrams visible in this slide." },
                { type: "image_url", image_url: { url: base64Data } }
              ]
            }
          ],
          temperature: 0.2
        })
      });
      const data = await res.json();
      if (!res.ok) throw new Error("Vision transcription error.");
      return data.choices[0].message.content;
    }

    function loadDemoLecture(type) {
      if (type === 'slides') {
        currentExtractedText = `[Slide 1: Stanford CS - Scaling Transformer Parameters]
Parameters are the fundamental floating-point weights inside transformer self-attention and feed-forward layers.

[Slide 2: What are Parameters?]
Inside every large language model live billions of learned parameters. A 7B model contains 7 billion weights; a 70B model contains 70 billion. Before training, these numbers are randomly initialized Gaussian noise.

[Slide 3: Backpropagation & Loss Optimization]
During pre-training, backpropagation computes loss gradients across trillions of tokens. Weights are updated incrementally using AdamW optimization.

[Slide 4: Quantization Trade-offs]
4-bit quantization (AWQ/GGUF) compresses 16-bit floats to 4-bit integers, reducing memory footprint to ~38GB for single-GPU inference with minimal perplexity loss.`;
      } else {
        currentExtractedText = `A parameter is a numerical weight in neural layers. A 7B model contains 7 billion weights dictating token probability calculations. Backpropagation adjusts these weights based on error gradients. Quantization compresses weights from 16-bit to 4-bit to fit large models onto consumer GPUs.`;
      }

      setForgeStep('processing');
      document.getElementById('processing-title').innerText = "Deconstructing Lecture Source...";
      document.getElementById('processing-subtitle').innerText = "Generating 4 diagnostic pre-test questions via Groq...";

      const preview = document.getElementById('processing-transcript-preview');
      preview.classList.remove('hidden');
      preview.innerText = currentExtractedText;

      generateDiagnosticFromTranscript(currentExtractedText);
    }

    // SAFE MODEL INFERENCE
    async function executeGroqWithFallback(messages, expectJson = true) {
      let lastErr = null;
      for (const model of CANDIDATE_MODELS) {
        try {
          const bodyPayload = { model, messages, temperature: 0.2 };
          if (expectJson) bodyPayload.response_format = { type: "json_object" };

          const res = await fetch("https://api.groq.com/openai/v1/chat/completions", {
            method: "POST",
            headers: {
              "Authorization": `Bearer ${GROQ_API_KEY}`,
              "Content-Type": "application/json"
            },
            body: JSON.stringify(bodyPayload)
          });

          const data = await res.json();
          if (!res.ok) {
            const msg = data.error?.message || `HTTP ${res.status}`;
            if (msg.includes('decommissioned') || msg.includes('deprecated') || msg.includes('not supported')) continue;
            lastErr = new Error(msg);
            continue;
          }

          if (data.choices && data.choices[0] && data.choices[0].message) {
            return data.choices[0].message.content;
          }
        } catch (e) {
          lastErr = e;
        }
      }
      throw lastErr || new Error("Inference call failed.");
    }

    function parseSafeJSON(rawStr) {
      let clean = rawStr.trim();
      clean = clean.replace(/^```json\s*/i, '').replace(/^```\s*/i, '').replace(/\s*```$/i, '');
      return JSON.parse(clean);
    }

    // DIAGNOSTIC PRE-TEST
    async function generateDiagnosticFromTranscript(transcript) {
      const messages = [
        {
          role: "system",
          content: "You are the ExpertForge Diagnostic Assessment Agent. Return strictly JSON."
        },
        {
          role: "user",
          content: `Analyze this lecture text:
"""${transcript}"""

Generate a 4-question pre-test:
Q1: Definition.
Q2: Mechanism.
Q3: Architecture trade-off.
Q4: Production optimization.

JSON schema:
{
  "questions": [
    { "id": 1, "q": "Question?", "options": ["A", "B", "C"], "correct": 0, "difficulty": "beginner" },
    { "id": 2, "q": "Question?", "options": ["A", "B", "C"], "correct": 1, "difficulty": "intermediate" },
    { "id": 3, "q": "Question?", "options": ["A", "B", "C"], "correct": 0, "difficulty": "advanced" },
    { "id": 4, "q": "Question?", "options": ["A", "B", "C"], "correct": 1, "difficulty": "advanced" }
  ]
}`
        }
      ];

      try {
        const raw = await executeGroqWithFallback(messages, true);
        const parsed = parseSafeJSON(raw);
        activeDiagnostic = parsed.questions || parsed.preTest || parsed;
      } catch (e) {
        activeDiagnostic = [
          { id: 1, q: "What is the primary role of parameters in a neural network?", options: ["Learned numerical weights that govern token probability distributions", "Hardware cooling fan controls", "Latency measurement counters"], correct: 0, difficulty: "beginner" },
          { id: 2, q: "How does backpropagation update model weights?", options: ["By resetting weights to 0", "By computing loss gradients and adjusting values incrementally", "By discarding unused context tokens"], correct: 1, difficulty: "intermediate" },
          { id: 3, q: "What is the primary trade-off of running 70B parameter models over 8B models?", options: ["Higher reasoning depth at the expense of increased VRAM and latency", "Complete loss of reasoning accuracy", "Lower power consumption"], correct: 0, difficulty: "advanced" },
          { id: 4, q: "Why is 4-bit quantization widely deployed in production?", options: ["It doubles vocabulary size", "It compresses memory footprint while preserving reasoning accuracy", "It eliminates temperature controls"], correct: 1, difficulty: "advanced" }
        ];
      }
      renderPreTestUI(activeDiagnostic);
      setForgeStep('pretest');
    }

    function renderPreTestUI(questions) {
      const container = document.getElementById('pretest-questions-list');
      container.innerHTML = questions.map((q, idx) => `
        <div class="bg-duo-card dark:bg-duo-darkCard p-5 rounded-2xl border-2 border-b-4 border-duo-border dark:border-duo-darkBorder space-y-3 shadow-sm">
          <div class="flex items-center justify-between">
            <p class="text-xs font-black text-slate-800 dark:text-slate-100">${idx + 1}. ${q.q}</p>
            <span class="text-[9px] font-mono font-black uppercase px-2 py-0.5 rounded-full bg-duo-stone dark:bg-duo-darkElevated border border-duo-border dark:border-duo-darkBorder text-slate-600 dark:text-slate-300">${q.difficulty}</span>
          </div>
          <div class="space-y-2">
            ${q.options.map((opt, oIdx) => `
              <label class="tactile-btn flex items-center gap-3 p-3 rounded-2xl bg-duo-stone/70 dark:bg-duo-darkElevated/50 border-2 border-b-4 border-duo-border dark:border-duo-darkBorder hover:border-duo-green cursor-pointer text-xs font-bold text-slate-700 dark:text-slate-200">
                <input type="radio" name="pretest-${q.id}" value="${oIdx}" class="text-duo-green focus:ring-0" />
                <span>${opt}</span>
              </label>
