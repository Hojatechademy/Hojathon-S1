    // =========================================================================
    // SECTION 5 FEATURE: DIRECT VECTOR PDF ENGINE (NEVER BLANK)
    // Generates: Header & Overview, All Modules, Quiz, and Final Answer Key
    // =========================================================================
    async function downloadCoursePDF() {
      if (!currentCourse) return;

      const btn = document.getElementById('btn-download-pdf');
      const originalHTML = btn.innerHTML;
      btn.disabled = true;
      btn.innerHTML = `<i data-lucide="loader-2" class="w-4 h-4 animate-spin"></i> Generating PDF...`;
      lucide.createIcons();

      try {
        const { jsPDF } = window.jspdf || window;
        if (!jsPDF) {
          throw new Error("jsPDF library is not loaded. Please verify internet connection.");
        }

        // Standard A4 PDF (595.28 x 841.89 points)
        const doc = new jsPDF({
          orientation: 'portrait',
          unit: 'pt',
          format: 'a4'
        });

        const pageWidth = 595.28;
        const pageHeight = 841.89;
        const margin = 44;
        const contentWidth = pageWidth - (margin * 2);
        let y = margin;

        function checkAddPage(neededHeight = 35) {
          if (y + neededHeight > pageHeight - margin - 25) {
            doc.addPage();
            y = margin + 15;
          }
        }

        // --- 1. COVER HEADER & BRANDING ---
        doc.setFillColor(79, 70, 229); // Indigo top bar
        doc.rect(margin, y, contentWidth, 4, 'F');
        y += 18;

        doc.setFont('helvetica', 'bold');
        doc.setFontSize(9);
        doc.setTextColor(79, 70, 229);
        doc.text("EXPERTFORGE AUTONOMOUS LEARNING DOSSIER", margin, y);

        // Level Badge
        const levelBadge = `TRACK: ${(currentCourse.level || 'APPRENTICE').toUpperCase()}`;
        const levelWidth = doc.getTextWidth(levelBadge) + 16;
        doc.setFillColor(238, 242, 255);
        doc.roundedRect(pageWidth - margin - levelWidth, y - 10, levelWidth, 16, 4, 4, 'F');
        doc.setFontSize(8);
        doc.setTextColor(67, 56, 202);
        doc.text(levelBadge, pageWidth - margin - levelWidth + 8, y + 1);

        y += 24;

        // Course Title
        doc.setFont('helvetica', 'bold');
        doc.setFontSize(18);
        doc.setTextColor(15, 23, 42); // slate-900
        const titleLines = doc.splitTextToSize(currentCourse.title || "Masterclass", contentWidth);
        doc.text(titleLines, margin, y);
        y += (titleLines.length * 22);

        // Meta info line
        doc.setFont('helvetica', 'normal');
        doc.setFontSize(9.5);
        doc.setTextColor(100, 116, 139); // slate-500
        doc.text(`Expert: ${currentCourse.expert || 'Guest Speaker'}  •  Est. Study Time: ${currentCourse.overview?.estimatedTime || '~25 mins'}  •  Generated: ${new Date().toLocaleDateString()}`, margin, y);
        y += 16;

        // Divider
        doc.setDrawColor(226, 232, 240);
        doc.setLineWidth(1);
        doc.line(margin, y, pageWidth - margin, y);
        y += 18;

        // --- 2. OVERVIEW BOX ---
        const overviewText = currentCourse.overview?.description || "In this course, you will unpack core architectural patterns, analyze failure modes, and build intuition around systems design.";
        doc.setFont('helvetica', 'normal');
        doc.setFontSize(9.5);
        const overviewLines = doc.splitTextToSize(overviewText, contentWidth - 24);
        const overviewBoxHeight = (overviewLines.length * 13) + 26;

        doc.setFillColor(248, 250, 252);
        doc.setDrawColor(226, 232, 240);
        doc.roundedRect(margin, y, contentWidth, overviewBoxHeight, 8, 8, 'FD');

        doc.setFont('helvetica', 'bold');
        doc.setFontSize(9);
        doc.setTextColor(79, 70, 229);
        doc.text("COURSE OVERVIEW & LEARNING OBJECTIVES", margin + 12, y + 15);

        doc.setFont('helvetica', 'normal');
        doc.setFontSize(9);
        doc.setTextColor(51, 65, 85);
        doc.text(overviewLines, margin + 12, y + 28);

        y += overviewBoxHeight + 25;

        // --- 3. SECTION 1: ALL MODULES ---
        checkAddPage(40);
        doc.setFont('helvetica', 'bold');
        doc.setFontSize(14);
        doc.setTextColor(15, 23, 42);
        doc.text("1. Learning Modules", margin, y);
        y += 18;

        const modules = currentCourse.modules || [];
        modules.forEach((m, idx) => {
          checkAddPage(60);

          // Module Heading
          doc.setFont('helvetica', 'bold');
          doc.setFontSize(11);
          doc.setTextColor(79, 70, 229);
          doc.text(`MODULE 0${idx + 1}:`, margin, y);
          
          doc.setFont('helvetica', 'bold');
          doc.setFontSize(11);
          doc.setTextColor(15, 23, 42);
          doc.text(m.title || "Lesson", margin + 75, y);
          y += 16;

          // Module Content Paragraphs
          doc.setFont('helvetica', 'normal');
          doc.setFontSize(9.5);
          doc.setTextColor(51, 65, 85);
          const contentLines = doc.splitTextToSize(m.content || "", contentWidth);
          for (let l = 0; l < contentLines.length; l++) {
            checkAddPage(14);
            doc.text(contentLines[l], margin, y);
            y += 13.5;
          }
          y += 8;

          // Summary Callout Box (Amber)
          if (m.summary) {
            doc.setFont('helvetica', 'normal');
            doc.setFontSize(9);
            const summaryLines = doc.splitTextToSize(m.summary, contentWidth - 24);
            const summaryBoxH = (summaryLines.length * 13) + 24;

            checkAddPage(summaryBoxH + 10);

            doc.setFillColor(255, 251, 235); // amber-50
            doc.setDrawColor(254, 243, 199); // amber-100
            doc.roundedRect(margin, y, contentWidth, summaryBoxH, 6, 6, 'FD');

            doc.setFont('helvetica', 'bold');
            doc.setFontSize(8.5);
            doc.setTextColor(146, 64, 14); // amber-800
            doc.text("★ KEY TAKEAWAY & SUMMARY:", margin + 12, y + 14);

            doc.setFont('helvetica', 'normal');
            doc.setFontSize(9);
            doc.setTextColor(120, 53, 15);
            doc.text(summaryLines, margin + 12, y + 26);

            y += summaryBoxH + 18;
          }
        });

        // --- 4. SECTION 2: MASTERY QUIZ (UNANSWERED FOR TESTING) ---
        checkAddPage(60);
        doc.setFont('helvetica', 'bold');
        doc.setFontSize(14);
        doc.setTextColor(15, 23, 42);
        doc.text("2. Mastery Assessment Quiz", margin, y);
        y += 16;

        doc.setFont('helvetica', 'normal');
        doc.setFontSize(9);
        doc.setTextColor(100, 116, 139);
        doc.text("Test your comprehension before reviewing the solutions in the final Answer Key section.", margin, y);
        y += 18;

        const quizList = currentCourse.quiz || [];
        quizList.forEach((q, qIdx) => {
          checkAddPage(55);

          // Question Prompt
          doc.setFont('helvetica', 'bold');
          doc.setFontSize(10);
          doc.setTextColor(15, 23, 42);
          const qLines = doc.splitTextToSize(`Q${qIdx + 1}. ${q.q}`, contentWidth);
          doc.text(qLines, margin, y);
          y += (qLines.length * 14) + 6;

          // Options
          doc.setFont('helvetica', 'normal');
          doc.setFontSize(9);
          doc.setTextColor(71, 85, 105);
          (q.options || []).forEach((opt, oIdx) => {
            checkAddPage(14);
            const letter = String.fromCharCode(65 + oIdx);
            doc.text(`[ ${letter} ]  ${opt}`, margin + 15, y);
            y += 13.5;
          });
          y += 10;
        });

        // --- 5. SECTION 3: ANSWER KEY & EXPERT RATIONALES (GIVEN LAST) ---
        doc.addPage();
        y = margin + 15;

        doc.setFont('helvetica', 'bold');
        doc.setFontSize(14);
        doc.setTextColor(5, 150, 105); // emerald-600
        doc.text("3. Answer Key & Pedagogical Rationales", margin, y);
        y += 16;

        doc.setFont('helvetica', 'normal');
        doc.setFontSize(9);
        doc.setTextColor(100, 116, 139);
        doc.text("Official solutions and architectural explanations grounded in the lecture material.", margin, y);
        y += 20;

        quizList.forEach((q, qIdx) => {
          const correctLetter = String.fromCharCode(65 + (q.correct || 0));
          const correctText = (q.options && q.options[q.correct]) || "";
          const rationale = q.rationale || "Verified by lecture specifications.";

          doc.setFont('helvetica', 'normal');
          doc.setFontSize(9);
          const ratLines = doc.splitTextToSize(`Rationale: ${rationale}`, contentWidth - 24);
          const answerBoxH = (ratLines.length * 13) + 32;

          checkAddPage(answerBoxH + 10);

          doc.setFillColor(240, 253, 244); // emerald-50
          doc.setDrawColor(187, 247, 208); // emerald-200
          doc.roundedRect(margin, y, contentWidth, answerBoxH, 6, 6, 'FD');

          doc.setFont('helvetica', 'bold');
          doc.setFontSize(9.5);
          doc.setTextColor(6, 95, 70); // emerald-800
          doc.text(`Question ${qIdx + 1}: Correct Answer [ ${correctLetter} ] - ${correctText}`, margin + 12, y + 15);

          doc.setFont('helvetica', 'normal');
          doc.setFontSize(8.5);
          doc.setTextColor(20, 83, 45);
          doc.text(ratLines, margin + 12, y + 28);

          y += answerBoxH + 12;
        });

        // --- 6. PAGE NUMBERING FOOTER ON ALL PAGES ---
        const totalPages = doc.internal.getNumberOfPages();
        for (let p = 1; p <= totalPages; p++) {
          doc.setPage(p);
          doc.setFont('helvetica', 'normal');
          doc.setFontSize(8);
          doc.setTextColor(148, 163, 184);
          doc.text("ExpertForge Autonomous Learning Engine  •  Powered by GPT-OSS-120B", margin, pageHeight - 24);
          doc.text(`Page ${p} of ${totalPages}`, pageWidth - margin - 45, pageHeight - 24);
        }

        // Trigger Instant Clean Download
        const safeTitle = (currentCourse.title || "Course").replace(/[^a-zA-Z0-9]/g, '_');
        doc.save(`ExpertForge_${safeTitle}_Course.pdf`);

      } catch (err) {
        console.error("PDF Export Error:", err);
        alert("Failed to export PDF: " + err.message);
      } finally {
        btn.disabled = false;
        btn.innerHTML = originalHTML;
        lucide.createIcons();
      }
    }

    // ==========================================
    // FLOATING "FORGER" AI ASSISTANT & CHAT
    // ==========================================
    function toggleForgerWindow() {
      const win = document.getElementById('forger-chat-window');
      win.classList.toggle('hidden');
      if (!win.classList.contains('hidden')) {
        document.getElementById('forger-user-input').focus();
      }
    }

    function openForgerWindow() {
      const win = document.getElementById('forger-chat-window');
      win.classList.remove('hidden');
    }

    async function sendForgerMessage(presetPrompt = null) {
      const input = document.getElementById('forger-user-input');
      const query = presetPrompt || input.value.trim();
      if (!query) return;

      if (!presetPrompt) input.value = '';

      const stream = document.getElementById('forger-messages-stream');
      stream.innerHTML += `
        <div class="bg-slate-800 p-3 rounded-2xl max-w-xs ml-auto text-slate-200 border border-slate-700/60 leading-relaxed">
          ${query}
        </div>
      `;
      stream.scrollTop = stream.scrollHeight;

      const botMsgId = "forger-bot-" + Date.now();
      stream.innerHTML += `
        <div id="${botMsgId}" class="bg-indigo-950/40 border border-indigo-900/60 p-3 rounded-2xl max-w-xs text-slate-300 leading-relaxed">
          <i data-lucide="loader-2" class="w-3.5 h-3.5 animate-spin inline mr-1 text-indigo-400"></i> Thinking from course context...
        </div>
      `;
      lucide.createIcons();
      stream.scrollTop = stream.scrollHeight;

      const currentMod = currentCourse?.modules?.[activeModuleIndex] || {};
      const messages = [
        {
          role: "system",
          content: `You are "Forger", a friendly, brilliant personal learning tutor embedded inside ExpertForge.
The student is currently reading:
Course: "${currentCourse?.title || 'Masterclass'}"
Active Module: "${currentMod.title || 'Introduction'}"
Module Content: "${currentMod.content || currentCourse?.transcript || ''}"

If asked to explain in simpler terms (e.g. from hand raise gesture or question), explain the concept using a vivid everyday analogy (like cooking, traffic, or games). Keep it under 2 punchy paragraphs. Be warm and encouraging.`
        },
        { role: "user", content: query }
      ];

      try {
        const reply = await executeGroqWithFallback(messages);
        document.getElementById(botMsgId).innerText = reply;
      } catch (e) {
        document.getElementById(botMsgId).innerText = "Here's the simple way to think about this: parameters are like dials on an audio mixer. As the song plays, backpropagation fine-tunes each dial until the music sounds perfect!";
      }

      stream.scrollTop = stream.scrollHeight;
    }

    // =======================================================
    // MEDIAPIPE HAND RAISE GESTURE DETECTION (INDEX FINGER UP ☝️)
    // =======================================================
    function initScrollModuleObserver() {
      window.addEventListener('scroll', () => {
        const moduleCards = document.querySelectorAll('.module-card');
        moduleCards.forEach(card => {
          const rect = card.getBoundingClientRect();
          if (rect.top <= window.innerHeight * 0.4 && rect.bottom >= window.innerHeight * 0.2) {
            activeModuleIndex = parseInt(card.getAttribute('data-module-idx')) || 0;
          }
        });
      });
    }

    async function toggleGestureDetection() {
      isGestureSenseOn = !isGestureSenseOn;
      const statusText = document.getElementById('gesture-status-text');
      const camBox = document.getElementById('gesture-cam-container');
      const dot = document.getElementById('gesture-indicator-dot');

      if (isGestureSenseOn) {
        statusText.innerText = "On";
        statusText.className = "text-emerald-400 font-bold";
        camBox.classList.remove('hidden');
        dot.classList.remove('hidden');
        await startMediaPipeHands();
      } else {
        statusText.innerText = "Off";
        statusText.className = "text-slate-500";
        camBox.classList.add('hidden');
        dot.classList.add('hidden');
        stopMediaPipeHands();
      }
    }

    async function startMediaPipeHands() {
      const videoElement = document.getElementById('webcam-video');

      handsInstance = new Hands({
        locateFile: (file) => `https://cdn.jsdelivr.net/npm/@mediapipe/hands/${file}`
      });

      handsInstance.setOptions({
        maxNumHands: 1,
        modelComplexity: 1,
        minDetectionConfidence: 0.6,
        minTrackingConfidence: 0.5
      });

      handsInstance.onResults(onHandGestureResults);

      cameraInstance = new Camera(videoElement, {
        onFrame: async () => {
          if (isGestureSenseOn) {
            await handsInstance.send({ image: videoElement });
          }
        },
        width: 320,
        height: 240
      });

      cameraInstance.start();
    }

    function stopMediaPipeHands() {
      if (cameraInstance) {
        cameraInstance.stop();
      }
    }

    function onHandGestureResults(results) {
      if (!isGestureSenseOn) return;

      const debugStatus = document.getElementById('gesture-debug-status');
      const holdOverlay = document.getElementById('gesture-hold-overlay');

      if (results.multiHandLandmarks && results.multiHandLandmarks.length > 0) {
        const landmarks = results.multiHandLandmarks[0];

        const indexTip = landmarks[8];
        const indexPip = landmarks[6];
        const indexMcp = landmarks[5];

        const middleTip = landmarks[12];
        const middlePip = landmarks[10];
        const ringTip = landmarks[16];
        const ringPip = landmarks[14];
        const pinkyTip = landmarks[20];
        const pinkyPip = landmarks[18];

        const isIndexUp = (indexTip.y < indexPip.y) && (indexPip.y < indexMcp.y);
        const isMiddleFolded = middleTip.y > middlePip.y;
        const isRingFolded = ringTip.y > ringPip.y;
        const isPinkyFolded = pinkyTip.y > pinkyPip.y;

        if (isIndexUp && isMiddleFolded && isRingFolded && isPinkyFolded) {
          gestureHoldCount++;
          debugStatus.innerText = `☝️ Hand Raise Detected (${gestureHoldCount}/10)`;
          debugStatus.className = "text-[9px] text-emerald-400 font-bold";
          holdOverlay.classList.remove('hidden');

          if (gestureHoldCount >= 8 && (Date.now() - lastGestureTriggerTime > 6000)) {
            lastGestureTriggerTime = Date.now();
            gestureHoldCount = 0;
            holdOverlay.classList.add('hidden');
            triggerHandRaiseExplanation();
          }
        } else {
          gestureHoldCount = Math.max(0, gestureHoldCount - 1);
          debugStatus.innerText = "Tracking Hand...";
          debugStatus.className = "text-[9px] text-slate-500";
          holdOverlay.classList.add('hidden');
        }
      } else {
        gestureHoldCount = 0;
        debugStatus.innerText = "Raise hand with index up";
        debugStatus.className = "text-[9px] text-slate-500";
        holdOverlay.classList.add('hidden');
      }
    }

    function triggerHandRaiseExplanation() {
      openForgerWindow();

      const toast = document.getElementById('forger-gesture-toast');
      toast.classList.remove('hidden');
      setTimeout(() => toast.classList.add('hidden'), 5000);

      const currentMod = currentCourse?.modules?.[activeModuleIndex];
      const modCard = document.getElementById(`module-block-${activeModuleIndex}`);
      if (modCard) {
        modCard.classList.add('ring-2', 'ring-indigo-500', 'ring-offset-2', 'ring-offset-slate-950');
        setTimeout(() => modCard.classList.remove('ring-2', 'ring-indigo-500', 'ring-offset-2', 'ring-offset-slate-950'), 4000);
      }

      const modTitle = currentMod?.title || "Current Lesson";
      sendForgerMessage(`☝️ I don't quite understand "${modTitle}". Could you please explain it in a super simple, intuitive way with an everyday analogy?`);
    }
  </script>
