      const fileName = file.name;
      const extension = fileName.split('.').pop().toLowerCase();
      const fileSizeMB = (file.size / (1024 * 1024)).toFixed(1);

      document.getElementById('upload-filename-display').innerText = `Selected: ${fileName} (${fileSizeMB} MB)`;
      setForgeStep('processing');

      try {
        if (['mp3', 'wav', 'm4a', 'aac', 'ogg'].includes(extension)) {
          document.getElementById('processing-title').innerText = "Transcribing Audio Lecture...";
          document.getElementById('processing-subtitle').innerText = "Streaming speech directly to Groq Whisper Large v3...";
          currentExtractedText = await transcribeAudioWithWhisper(file);
        } else if (extension === 'pdf') {
          document.getElementById('processing-title').innerText = "Parsing PDF Lecture Deck...";
          document.getElementById('processing-subtitle').innerText = "Extracting slide pages, headings, and notes via PDF.js...";
          currentExtractedText = await extractPdfText(file);
        } else if (extension === 'docx') {
          document.getElementById('processing-title').innerText = "Parsing Word Document...";
          document.getElementById('processing-subtitle').innerText = "Extracting document structure via Mammoth.js...";
          currentExtractedText = await extractDocxText(file);
        } else if (['png', 'jpg', 'jpeg', 'webp'].includes(extension)) {
          document.getElementById('processing-title').innerText = "Analyzing Slide / Whiteboard Image...";
          document.getElementById('processing-subtitle').innerText = "Transcribing visual diagrams with Groq Vision...";
          currentExtractedText = await extractImageWithVision(file);
        } else if (extension === 'txt' || extension === 'md') {
          document.getElementById('processing-title').innerText = "Reading Text Notes...";
          document.getElementById('processing-subtitle').innerText = "Loading raw lecture notes...";
          currentExtractedText = await file.text();
        } else {
          throw new Error("Unsupported format. Please upload MP3, PDF, DOCX, TXT, or Image.");
