        maxNumHands: 1,
        modelComplexity: 1,
        minDetectionConfidence: 0.6,
        minTrackingConfidence: 0.5
      });

      handsInstance.onResults(onHandGestureResults);

      cameraInstance = new Camera(videoElement, {
        onFrame: async () => {
          if (isGestureSenseOn) {
            await handsInstance.send({ image: videoElement });
          }
        },
        width: 320,
        height: 240
      });

      cameraInstance.start();
    }

    function stopMediaPipeHands() {
      if (cameraInstance) {
        cameraInstance.stop();
      }
    }

    function onHandGestureResults(results) {
      if (!isGestureSenseOn) return;

      const hud = document.getElementById('gesture-hud');
      const hudText = document.getElementById('gesture-hud-text');
      const progressBar = document.getElementById('gesture-progress-bar');

      if (results.multiHandLandmarks && results.multiHandLandmarks.length > 0) {
        const landmarks = results.multiHandLandmarks[0];

        const indexTip = landmarks[8];
        const indexPip = landmarks[6];
        const indexMcp = landmarks[5];

        const middleTip = landmarks[12];
        const middlePip = landmarks[10];
        const ringTip = landmarks[16];
        const ringPip = landmarks[14];
        const pinkyTip = landmarks[20];
        const pinkyPip = landmarks[18];

        const isIndexUp = (indexTip.y < indexPip.y) && (indexPip.y < indexMcp.y);
        const isMiddleUp = (middleTip.y < middlePip.y);
        const isRingUp = (ringTip.y < ringPip.y);
        const isPinkyUp = (pinkyTip.y < pinkyPip.y);

        const isMiddleFolded = middleTip.y > middlePip.y;
        const isRingFolded = ringTip.y > ringPip.y;
        const isPinkyFolded = pinkyTip.y > pinkyPip.y;

        const isOnlyIndexUp = isIndexUp && isMiddleFolded && isRingFolded && isPinkyFolded;
        const isAllFingersUp = isIndexUp && isMiddleUp && isRingUp && isPinkyUp;

        if (isOnlyIndexUp) {
          gestureHoldCount_Index++;
          gestureHoldCount_All = 0;
          hud.classList.remove('hidden');
          hudText.innerText = `☝️ Index up • Hold for explanation (${gestureHoldCount_Index}/8)`;
          progressBar.style.width = `${Math.min(100, (gestureHoldCount_Index / 8) * 100)}%`;

          if (gestureHoldCount_Index >= 8 && (Date.now() - lastGestureTriggerTime > 5000)) {
            lastGestureTriggerTime = Date.now();
            gestureHoldCount_Index = 0;
            progressBar.style.width = '0%';
            hud.classList.add('hidden');
            triggerHandRaiseExplanation();
          }
          return;
        }

        if (isAllFingersUp) {
          gestureHoldCount_All++;
          gestureHoldCount_Index = 0;
          hud.classList.remove('hidden');
          hudText.innerText = `✋ All fingers up • Hold for Module MCQ (${gestureHoldCount_All}/8)`;
          progressBar.style.width = `${Math.min(100, (gestureHoldCount_All / 8) * 100)}%`;

          if (gestureHoldCount_All >= 8 && (Date.now() - lastGestureTriggerTime > 5000)) {
            lastGestureTriggerTime = Date.now();
            gestureHoldCount_All = 0;
            progressBar.style.width = '0%';
            hud.classList.add('hidden');
            triggerModuleQuickQuiz(activeModuleIndex);
          }
          return;
        }

        gestureHoldCount_Index = Math.max(0, gestureHoldCount_Index - 1);
        gestureHoldCount_All = Math.max(0, gestureHoldCount_All - 1);
        if (gestureHoldCount_Index === 0 && gestureHoldCount_All === 0) {
          hud.classList.add('hidden');
          progressBar.style.width = '0%';
        }

      } else {
        gestureHoldCount_Index = 0;
        gestureHoldCount_All = 0;
        hud.classList.add('hidden');
        progressBar.style.width = '0%';
      }
    }

    function triggerHandRaiseExplanation() {
      openForgerWindow();

      const toast = document.getElementById('forger-gesture-toast');
      toast.classList.remove('hidden');
      setTimeout(() => toast.classList.add('hidden'), 5000);

      const currentMod = currentCourse?.modules?.[activeModuleIndex];
      const modCard = document.getElementById(`module-block-${activeModuleIndex}`);
      if (modCard) {
        modCard.classList.add('ring-2', 'ring-indigo-500', 'ring-offset-2');
        setTimeout(() => modCard.classList.remove('ring-2', 'ring-indigo-500', 'ring-offset-2'), 4000);
      }

      const modTitle = currentMod?.title || "Current Lesson";
      sendForgerMessage(`☝️ I don't quite understand "${modTitle}". Could you please explain it in a super simple, intuitive way with an everyday analogy?`);
    }
  </script>
