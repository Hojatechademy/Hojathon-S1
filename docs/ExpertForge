    let isGestureSenseOn = false;
    let cameraInstance = null;
    let handsInstance = null;
    let gestureHoldCount_Index = 0;
    let gestureHoldCount_All = 0;
    let lastGestureTriggerTime = 0;

    const CANDIDATE_MODELS = [
      "llama-3.3-70b-versatile",
