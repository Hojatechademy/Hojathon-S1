    // SAFE MODEL EXECUTION (AUTOMATICALLY SKIPS ANY DEPRECATED / DECOMMISSIONED MODELS)
    async function executeGroqWithFallback(messages, expectJson = true) {
      let lastErr = null;
      for (const model of CANDIDATE_MODELS) {
        try {
          const bodyPayload = {
            model: model,
            messages: messages,
            temperature: 0.25
          };
          if (expectJson) {
            bodyPayload.response_format = { type: "json_object" };
          }

          const res = await fetch("https://api.groq.com/openai/v1/chat/completions", {
            method: "POST",
            headers: {
              "Authorization": `Bearer ${GROQ_API_KEY}`,
              "Content-Type": "application/json"
            },
            body: JSON.stringify(bodyPayload)
          });

          const data = await res.json();
          if (!res.ok) {
            const msg = data.error?.message || `HTTP ${res.status}`;
            // If the model is decommissioned or deprecated, discard and move to next model immediately
            if (msg.includes('decommissioned') || msg.includes('deprecated') || msg.includes('not supported')) {
              continue;
            }
            lastErr = new Error(msg);
            continue;
          }

          if (data.choices && data.choices[0] && data.choices[0].message) {
            document.getElementById('active-model-tag').innerText = model.split('/').pop().toUpperCase();
            return data.choices[0].message.content;
          }
        } catch (e) {
          lastErr = e;
        }
      }
      throw lastErr || new Error("Groq generation failed.");
    }

    function parseSafeJSON(rawStr) {
      let clean = rawStr.trim();
      clean = clean.replace(/^```json\s*/i, '').replace(/^```\s*/i, '').replace(/\s*```$/i, '');
      return JSON.parse(clean);
    }

