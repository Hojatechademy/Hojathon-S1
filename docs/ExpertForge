<!DOCTYPE html>
<html lang="en" class="light">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>ExpertForge - Tactile Learning Engine</title>

  <!-- Open-Source Fonts: Nunito (Duolingo-style friendly rounded) + Outfit + JetBrains Mono -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@500;700&family=Nunito:wght@500;600;700;800;900&family=Outfit:wght@600;700;800;900&display=swap" rel="stylesheet" />

  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          fontFamily: {
            sans: ['"Nunito"', 'system-ui', 'sans-serif'],
            display: ['"Outfit"', '"Nunito"', 'sans-serif'],
            mono: ['"JetBrains Mono"', 'monospace'],
          },
          colors: {
            duo: {
              green: '#58CC02',
              greenDark: '#46A302',
              greenLight: '#D7FFB8',
              yellow: '#FFC800',
              yellowDark: '#E5A500',
              yellowLight: '#FFF4D0',
              blue: '#1CB0F6',
              blueDark: '#1899D6',
              blueLight: '#DDF4FF',
              coral: '#FF4B4B',
              coralDark: '#EA2B2B',
              coralLight: '#FFDFE0',
              stone: '#F5EFE6',
              card: '#FFFCF7',
              border: '#E5DECB',
              darkBg: '#131F24',
              darkCard: '#1B272D',
              darkBorder: '#28383F',
              darkElevated: '#22323A'
            }
          }
        }
      }
    }
  </script>

  <!-- Lucide Icons -->
  <script src="https://unpkg.com/lucide@latest"></script>
  <!-- PDF.js for PDF slides parsing -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js"></script>
  <!-- Mammoth.js for Word DOCX parsing -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/mammoth/1.6.0/mammoth.browser.min.js"></script>
  <!-- MediaPipe Hands & Camera Utils for Gesture Detection -->
  <script src="https://cdn.jsdelivr.net/npm/@mediapipe/camera_utils/camera_utils.js" crossorigin="anonymous"></script>
  <script src="https://cdn.jsdelivr.net/npm/@mediapipe/hands/hands.js" crossorigin="anonymous"></script>
  <!-- Vector jsPDF Library -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>

  <style>
    .perspective { perspective: 1000px; }
    .transform-style-preserve { transform-style: preserve-3d; }
    .rotate-y-180 { transform: rotateY(180deg); }
    .backface-hidden { backface-visibility: hidden; }

    /* Tactile 3D button press physics */
    .tactile-btn {
      transition: all 0.08s ease-in-out;
      user-select: none;
    }
    .tactile-btn:active {
      transform: translateY(3px);
      border-bottom-width: 1px !important;
    }

    /* Custom smooth scrollbar */
    ::-webkit-scrollbar { width: 6px; height: 6px; }
    ::-webkit-scrollbar-track { background: transparent; }
    ::-webkit-scrollbar-thumb { background: #D5CCA8; border-radius: 9999px; }
    .dark ::-webkit-scrollbar-thumb { background: #28383F; }
  </style>
</head>
<body class="bg-duo-stone text-slate-800 dark:bg-duo-darkBg dark:text-slate-100 min-h-screen font-sans antialiased selection:bg-duo-green selection:text-white flex flex-col relative transition-colors duration-200">

  <!-- SIDE-CENTERED TACTILE NAVIGATION CONSOLE -->
  <aside id="side-nav" class="fixed left-3 sm:left-6 top-1/2 -translate-y-1/2 z-40 flex flex-col items-center gap-3 p-2 sm:p-2.5 bg-duo-card dark:bg-duo-darkCard border-2 border-b-4 border-duo-border dark:border-duo-darkBorder rounded-3xl shadow-lg">
    
    <!-- Brand Button -->
    <button onclick="goToView('home')" class="tactile-btn w-12 h-12 rounded-2xl bg-duo-green border-2 border-b-4 border-duo-greenDark flex items-center justify-center text-white shadow-sm" title="ExpertForge Home">
      <i data-lucide="zap" class="w-6 h-6 fill-white"></i>
    </button>

    <div class="w-7 h-0.5 bg-duo-border dark:bg-duo-darkBorder my-0.5 rounded-full"></div>

    <!-- Home Navigation Button -->
    <button onclick="goToView('home')" id="nav-btn-home" class="tactile-btn w-11 h-11 rounded-2xl bg-duo-stone dark:bg-duo-darkElevated border-2 border-b-4 border-duo-border dark:border-duo-darkBorder flex items-center justify-center text-slate-600 dark:text-slate-300 hover:text-duo-green" title="Home Hub">
      <i data-lucide="compass" class="w-5 h-5"></i>
    </button>

    <!-- Forge New Course Button -->
    <button onclick="startForgeFlow()" id="nav-btn-forge" class="tactile-btn w-11 h-11 rounded-2xl bg-duo-stone dark:bg-duo-darkElevated border-2 border-b-4 border-duo-border dark:border-duo-darkBorder flex items-center justify-center text-slate-600 dark:text-slate-300 hover:text-duo-blue" title="Forge Course">
      <i data-lucide="plus" class="w-5 h-5 stroke-[3]"></i>
    </button>

    <!-- Saved Courses Library Button -->
    <button onclick="goToView('courses')" id="nav-btn-courses" class="tactile-btn w-11 h-11 rounded-2xl bg-duo-stone dark:bg-duo-darkElevated border-2 border-b-4 border-duo-border dark:border-duo-darkBorder flex items-center justify-center text-slate-600 dark:text-slate-300 hover:text-duo-yellowDark" title="Course Library">
      <i data-lucide="book-marked" class="w-5 h-5"></i>
    </button>

    <div class="w-7 h-0.5 bg-duo-border dark:bg-duo-darkBorder my-0.5 rounded-full"></div>

    <!-- Private Gestures Toggle Button -->
    <button onclick="toggleGestureDetection()" id="side-gesture-btn" class="tactile-btn w-11 h-11 rounded-2xl bg-duo-stone dark:bg-duo-darkElevated border-2 border-b-4 border-duo-border dark:border-duo-darkBorder flex items-center justify-center text-slate-600 dark:text-slate-300 hover:text-duo-green relative" title="Toggle Private Gestures">
      <i data-lucide="hand" class="w-5 h-5"></i>
      <span id="side-gesture-dot" class="hidden absolute top-2 right-2 w-2.5 h-2.5 rounded-full bg-duo-green animate-ping"></span>
    </button>

    <!-- Theme Switcher Button -->
    <button onclick="toggleDarkMode()" id="theme-toggle-btn" class="tactile-btn w-11 h-11 rounded-2xl bg-duo-stone dark:bg-duo-darkElevated border-2 border-b-4 border-duo-border dark:border-duo-darkBorder flex items-center justify-center text-slate-600 dark:text-slate-300 hover:text-duo-yellowDark" title="Light / Dark Mode">
      <i id="theme-icon" data-lucide="moon" class="w-5 h-5"></i>
    </button>
  </aside>

  <!-- SIDE-ANCHORED GESTURE NOTIFICATION BADGE -->
  <div id="gesture-hud" class="fixed top-6 left-20 sm:left-24 z-50 hidden transition-all duration-300">
    <div class="flex items-center gap-2.5 bg-duo-card dark:bg-duo-darkCard border-2 border-b-4 border-duo-border dark:border-duo-darkBorder px-4 py-2 rounded-2xl shadow-lg">
      <span class="w-2.5 h-2.5 rounded-full bg-duo-green animate-pulse"></span>
      <span id="gesture-hud-text" class="text-xs font-black text-slate-800 dark:text-slate-100 uppercase tracking-wide">
        Gesture Active
      </span>
      <div class="w-14 h-2 bg-duo-stone dark:bg-duo-darkBorder rounded-full overflow-hidden">
        <div id="gesture-progress-bar" class="h-full bg-duo-green w-0 transition-all duration-100"></div>
      </div>
    </div>
  </div>

  <!-- MAIN VIEWPORT CONTAINER -->
  <main class="max-w-4xl mx-auto pl-20 sm:pl-28 pr-4 sm:pr-8 py-10 flex-1 w-full pb-32">

    <!-- VIEW 1: HOME HUB -->
    <section id="view-home" class="space-y-8">
      <!-- Mascot / Hero Banner -->
      <div class="bg-duo-card dark:bg-duo-darkCard border-2 border-b-4 border-duo-border dark:border-duo-darkBorder rounded-3xl p-6 sm:p-8 flex flex-col sm:flex-row items-center gap-6 shadow-sm">
        <div class="w-20 h-20 sm:w-24 sm:h-24 rounded-3xl bg-duo-yellow border-2 border-b-4 border-duo-yellowDark flex items-center justify-center text-4xl shrink-0 shadow-inner">
          ⚡
        </div>
        <div class="space-y-2 text-center sm:text-left">
          <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-duo-greenLight dark:bg-duo-darkElevated border border-duo-green text-duo-greenDark dark:text-duo-green text-[11px] font-black uppercase tracking-wider">
            <span>Autonomous Masterclass</span>
          </div>
          <h1 class="text-2xl sm:text-4xl font-black font-display tracking-tight text-slate-900 dark:text-white">
            ExpertForge.
          </h1>
          <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 font-semibold max-w-lg leading-relaxed">
            Ingest lectures, slide decks, audio, and whiteboard notes. Transform raw knowledge into calibrated milestones, 3D flashcards, mindmaps, and dossiers.
          </p>
        </div>
      </div>

      <!-- PRIMARY TACTILE ACTION CARDS -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
        
        <!-- CARD 1: FORGE COURSE -->
        <div onclick="startForgeFlow()" class="tactile-btn group bg-duo-green hover:bg-[#52be02] border-2 border-b-4 border-duo-greenDark rounded-3xl p-7 text-white cursor-pointer shadow-sm flex flex-col justify-between min-h-[220px]">
          <div class="space-y-3">
            <div class="w-12 h-12 rounded-2xl bg-white/20 border border-white/30 flex items-center justify-center text-white text-2xl">
              🚀
            </div>
            <div>
              <h2 class="text-xl font-black font-display tracking-tight">Forge a Course</h2>
              <p class="text-xs text-white/90 font-bold mt-1 leading-relaxed">
                Upload audio, slide decks, or Word docs. Complete a 4-question diagnostic to synthesize your custom track.
              </p>
            </div>
          </div>
          <div class="pt-4 flex items-center justify-between text-xs font-black uppercase tracking-wider">
            <span>Start Ingest Wizard</span>
            <div class="w-8 h-8 rounded-full bg-white text-duo-greenDark flex items-center justify-center">
              <i data-lucide="arrow-right" class="w-4 h-4 stroke-[3]"></i>
            </div>
          </div>
        </div>

        <!-- CARD 2: SAVED COURSES -->
        <div onclick="goToView('courses')" class="tactile-btn group bg-duo-card dark:bg-duo-darkCard hover:bg-[#fff9ef] dark:hover:bg-duo-darkElevated border-2 border-b-4 border-duo-border dark:border-duo-darkBorder rounded-3xl p-7 cursor-pointer shadow-sm flex flex-col justify-between min-h-[220px]">
          <div class="space-y-3">
            <div class="w-12 h-12 rounded-2xl bg-duo-yellowLight dark:bg-duo-darkElevated border border-duo-yellow border-b-2 flex items-center justify-center text-2xl">
              📚
            </div>
            <div>
              <h2 class="text-xl font-black font-display tracking-tight text-slate-900 dark:text-white">Course Library</h2>
              <p class="text-xs text-slate-600 dark:text-slate-400 font-bold mt-1 leading-relaxed">
                Revisit saved modules, flip 3D flashcards, inspect conceptual mindmaps, and export verified PDF dossiers.
              </p>
            </div>
          </div>
          <div class="pt-4 flex items-center justify-between text-xs font-black uppercase tracking-wider text-duo-yellowDark dark:text-duo-yellow">
            <span>Open Vault</span>
            <div class="w-8 h-8 rounded-full bg-duo-stone dark:bg-duo-darkBorder text-slate-700 dark:text-slate-200 flex items-center justify-center">
              <i data-lucide="arrow-right" class="w-4 h-4 stroke-[3]"></i>
            </div>
          </div>
        </div>

      </div>

      <!-- GESTURE SHORTCUT INFO PILL -->
      <div class="bg-duo-card dark:bg-duo-darkCard border-2 border-b-4 border-duo-border dark:border-duo-darkBorder rounded-3xl p-5 flex items-center justify-between gap-4">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-2xl bg-duo-blueLight dark:bg-duo-darkElevated border border-duo-blue flex items-center justify-center text-lg">
            ✋
          </div>
          <div>
            <h4 class="text-xs font-black uppercase tracking-wider text-slate-900 dark:text-white">Tactile Hands-Free Gestures</h4>
            <p class="text-[11px] text-slate-600 dark:text-slate-400 font-bold">Raise <strong>☝️ Index</strong> for simple analogies • Raise <strong>✋ Open Hand</strong> for module quiz</p>
          </div>
        </div>
        <button onclick="toggleGestureDetection()" class="tactile-btn px-4 py-2 rounded-2xl bg-duo-blue border-2 border-b-4 border-duo-blueDark text-white text-xs font-black uppercase tracking-wider">
          Toggle
        </button>
      </div>
    </section>

    <!-- VIEW 2: MULTIMODAL FORGE WIZARD -->
    <section id="view-forge" class="hidden space-y-6">
      <button onclick="goToView('home')" class="text-xs font-black text-slate-500 dark:text-slate-400 hover:text-duo-green flex items-center gap-1.5 transition">
        <i data-lucide="arrow-left" class="w-4 h-4 stroke-[3]"></i> Return to Hub
      </button>

      <!-- Step 1: Upload Material -->
      <div id="forge-step-upload" class="bg-duo-card dark:bg-duo-darkCard border-2 border-b-4 border-duo-border dark:border-duo-darkBorder rounded-3xl p-7 sm:p-9 space-y-6 shadow-sm">
        <div class="space-y-1">
          <div class="inline-block px-3 py-0.5 rounded-full bg-duo-yellowLight dark:bg-duo-darkElevated border border-duo-yellow text-duo-yellowDark dark:text-duo-yellow text-[10px] font-black uppercase tracking-wider">
            Stage 01 • Ingestion
          </div>
          <h2 class="text-2xl font-black font-display text-slate-900 dark:text-white">Upload Lecture Material</h2>
          <p class="text-xs text-slate-600 dark:text-slate-400 font-bold">Audio (MP3/WAV), Slide Decks (PDF), Documents (DOCX/TXT), or Whiteboard Photos</p>
        </div>

        <div>
          <label class="block text-xs font-black uppercase tracking-wider text-slate-500 dark:text-slate-400 mb-2">Masterclass Title (Optional)</label>
          <input id="input-lecture-title" type="text" placeholder="e.g. LLM Parameters & Architecture" class="w-full bg-duo-stone dark:bg-duo-darkBg border-2 border-duo-border dark:border-duo-darkBorder rounded-2xl px-4 py-3 text-xs font-bold text-slate-800 dark:text-slate-100 focus:outline-none focus:border-duo-green transition" />
        </div>

        <!-- Dropzone -->
        <div class="border-2 border-dashed border-duo-border dark:border-duo-darkBorder hover:border-duo-green rounded-3xl p-8 text-center space-y-3 transition bg-duo-stone/40 dark:bg-duo-darkElevated/30">
          <input type="file" id="universal-file-input" accept="audio/*,.pdf,.docx,.txt,image/*" class="hidden" onchange="handleUniversalUpload(event)" />
          
          <div class="flex justify-center items-center gap-2">
            <span class="text-2xl">🎧</span>
            <span class="text-2xl">📄</span>
            <span class="text-2xl">📝</span>
            <span class="text-2xl">🖼️</span>
          </div>

          <label for="universal-file-input" class="tactile-btn inline-flex items-center gap-2 cursor-pointer px-5 py-2.5 rounded-2xl bg-duo-blue border-2 border-b-4 border-duo-blueDark text-white text-xs font-black uppercase tracking-wider">
            <i data-lucide="upload" class="w-4 h-4 stroke-[3]"></i> Choose Lecture File
          </label>
          <p class="text-[11px] text-slate-500 dark:text-slate-400 font-bold" id="upload-filename-display">Accepts MP3, WAV, PDF, DOCX, TXT, PNG, JPG</p>
        </div>

        <div class="pt-2 flex flex-col sm:flex-row items-center justify-between gap-3 border-t-2 border-duo-border dark:border-duo-darkBorder">
          <span class="text-xs text-slate-500 dark:text-slate-400 font-bold">Or load a pre-processed demo:</span>
          <div class="flex gap-2">
            <button onclick="loadDemoLecture('slides')" class="tactile-btn px-4 py-2 rounded-2xl bg-duo-stone dark:bg-duo-darkElevated border-2 border-b-4 border-duo-border dark:border-duo-darkBorder text-slate-700 dark:text-slate-200 text-xs font-black">
              📊 Stanford Slides
            </button>
            <button onclick="loadDemoLecture('audio')" class="tactile-btn px-4 py-2 rounded-2xl bg-duo-stone dark:bg-duo-darkElevated border-2 border-b-4 border-duo-border dark:border-duo-darkBorder text-slate-700 dark:text-slate-200 text-xs font-black">
              🎙️ Audio Lecture
            </button>
          </div>
        </div>
      </div>

      <!-- Step 2: Processing Spinner -->
      <div id="forge-step-processing" class="hidden bg-duo-card dark:bg-duo-darkCard border-2 border-b-4 border-duo-border dark:border-duo-darkBorder rounded-3xl p-10 space-y-4 text-center shadow-sm">
        <div class="w-12 h-12 mx-auto rounded-2xl bg-duo-yellow border-2 border-b-4 border-duo-yellowDark flex items-center justify-center text-2xl animate-bounce">
          ⚡
        </div>
        <div class="space-y-1">
          <h3 id="processing-title" class="text-lg font-black font-display text-slate-900 dark:text-white">Synthesizing Course Primitives...</h3>
          <p id="processing-subtitle" class="text-xs font-bold text-slate-500 dark:text-slate-400">Analyzing lecture material via neural inference...</p>
        </div>
        <div id="processing-transcript-preview" class="hidden text-left bg-duo-stone dark:bg-duo-darkBg p-4 rounded-2xl border-2 border-duo-border dark:border-duo-darkBorder font-mono text-[11px] text-slate-700 dark:text-slate-300 max-h-36 overflow-y-auto"></div>
      </div>

      <!-- Step 3: Diagnostic Pre-Test -->
      <div id="forge-step-pretest" class="hidden bg-duo-card dark:bg-duo-darkCard border-2 border-b-4 border-duo-border dark:border-duo-darkBorder rounded-3xl p-7 sm:p-9 space-y-6 shadow-sm">
        <div class="space-y-1 pb-3 border-b-2 border-duo-border dark:border-duo-darkBorder">
          <div class="inline-block px-3 py-0.5 rounded-full bg-duo-greenLight dark:bg-duo-darkElevated border border-duo-green text-duo-greenDark dark:text-duo-green text-[10px] font-black uppercase tracking-wider">
            Stage 02 • Skill Calibration
          </div>
          <h2 class="text-2xl font-black font-display text-slate-900 dark:text-white">Diagnostic Pre-Test</h2>
          <p class="text-xs text-slate-600 dark:text-slate-400 font-bold">Answer these 4 questions so the system can scale module depth, mindmaps, and flashcards.</p>
        </div>

        <div id="pretest-questions-list" class="space-y-5"></div>

        <button onclick="submitPreTest()" class="tactile-btn w-full py-4 bg-duo-green border-2 border-b-4 border-duo-greenDark rounded-2xl text-xs font-black uppercase tracking-wider text-white shadow-sm flex items-center justify-center gap-2">
          <span>Evaluate & Forge Custom Course</span>
          <i data-lucide="arrow-right" class="w-4 h-4 stroke-[3]"></i>
        </button>
      </div>
    </section>

    <!-- VIEW 3: SAVED COURSES LIBRARY -->
    <section id="view-courses" class="hidden space-y-6">
      <div class="flex items-center justify-between pb-2 border-b-2 border-duo-border dark:border-duo-darkBorder">
        <div>
          <h2 class="text-2xl font-black font-display text-slate-900 dark:text-white">Course Library</h2>
          <p class="text-xs text-slate-600 dark:text-slate-400 font-bold">Saved locally on your device.</p>
        </div>
        <button onclick="startForgeFlow()" class="tactile-btn px-4 py-2 bg-duo-green border-2 border-b-4 border-duo-greenDark text-white rounded-2xl text-xs font-black uppercase tracking-wider flex items-center gap-1.5">
          <i data-lucide="plus" class="w-4 h-4 stroke-[3]"></i> Forge New
        </button>
      </div>

      <div id="courses-grid" class="grid grid-cols-1 sm:grid-cols-2 gap-5"></div>
    </section>

    <!-- VIEW 4: COURSE STUDY HUB -->
    <section id="view-course-study" class="hidden space-y-6">
      <!-- Course Header Banner -->
      <div class="bg-duo-card dark:bg-duo-darkCard border-2 border-b-4 border-duo-border dark:border-duo-darkBorder rounded-3xl p-6 sm:p-8 space-y-3 shadow-sm">
        <div class="flex items-center justify-between">
          <button onclick="goToView('courses')" class="text-xs font-black text-slate-500 dark:text-slate-400 hover:text-duo-green flex items-center gap-1 transition">
            <i data-lucide="arrow-left" class="w-4 h-4 stroke-[3]"></i> All Courses
          </button>
          <span id="study-track-pill" class="text-[10px] font-mono font-black uppercase px-3 py-1 rounded-full bg-duo-yellowLight dark:bg-duo-darkElevated border border-duo-yellow text-duo-yellowDark dark:text-duo-yellow">
            Level 2: Architect
          </span>
        </div>
        <h1 id="study-course-title" class="text-2xl sm:text-3xl font-black font-display text-slate-900 dark:text-white leading-tight"></h1>
        <p id="study-course-expert" class="text-xs font-bold text-slate-600 dark:text-slate-400"></p>
      </div>

      <!-- Tactile Navigation Tabs -->
      <div class="flex gap-2 overflow-x-auto pb-1 font-black text-xs">
        <button onclick="setStudyTab('overview')" id="study-tab-btn-overview" class="tactile-btn px-4 py-2.5 rounded-2xl border-2 border-b-4 border-duo-greenDark bg-duo-green text-white whitespace-nowrap">
          1. Overview
        </button>
        <button onclick="setStudyTab('modules')" id="study-tab-btn-modules" class="tactile-btn px-4 py-2.5 rounded-2xl border-2 border-b-4 border-duo-border dark:border-duo-darkBorder bg-duo-stone dark:bg-duo-darkElevated text-slate-700 dark:text-slate-300 whitespace-nowrap">
          2. Modules
        </button>
        <button onclick="setStudyTab('flashcards')" id="study-tab-btn-flashcards" class="tactile-btn px-4 py-2.5 rounded-2xl border-2 border-b-4 border-duo-border dark:border-duo-darkBorder bg-duo-stone dark:bg-duo-darkElevated text-slate-700 dark:text-slate-300 whitespace-nowrap">
          3. 3D Flashcards
        </button>
        <button onclick="setStudyTab('quiz')" id="study-tab-btn-quiz" class="tactile-btn px-4 py-2.5 rounded-2xl border-2 border-b-4 border-duo-border dark:border-duo-darkBorder bg-duo-stone dark:bg-duo-darkElevated text-slate-700 dark:text-slate-300 whitespace-nowrap">
          4. Mastery Quiz
        </button>
        <button onclick="setStudyTab('mindmap')" id="study-tab-btn-mindmap" class="tactile-btn px-4 py-2.5 rounded-2xl border-2 border-b-4 border-duo-border dark:border-duo-darkBorder bg-duo-stone dark:bg-duo-darkElevated text-slate-700 dark:text-slate-300 whitespace-nowrap">
          5. Mindmap & PDF
        </button>
      </div>

      <!-- TAB 1: OVERVIEW -->
      <div id="study-tab-overview" class="space-y-4">
